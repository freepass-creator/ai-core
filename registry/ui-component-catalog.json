  "components": {
    "B01": {"name":"주 실행 버튼","use":"저장·완료 등 현재 화면의 단일 핵심 실행","avoid":"단순 이동이나 보조 동작","class":"ui-button","states":["hover","focus-visible","disabled","busy"]},
    "B02": {"name":"보조 실행 버튼","use":"취소·이전·수정","avoid":"핵심 완료 동작","class":"ui-button secondary","states":["hover","focus-visible","disabled"]},
    "B03": {"name":"단계 진행 버튼","use":"입력 흐름의 다음·신청","avoid":"전역 화면 이동","class":"ui-button","states":["disabled","busy"]},
    "S01": {"name":"목록 검색·필터","use":"목록을 좁혀 찾기","avoid":"새 데이터 입력","class":"model-toolbar model-control","states":["focus","disabled","error"]},
    "S02": {"name":"라벨 입력·선택","use":"폼 값 입력과 dropdown 선택","avoid":"목록 검색","class":"model-field model-control","states":["focus","invalid","disabled","busy"]},
    "L01": {"name":"단일 카드 행 목록","use":"전체 행을 눌러 항목 선택","avoid":"다열 수치 비교","class":"model-list model-row","states":["hover","selected","disabled"]},
    "L02": {"name":"경계 있는 데이터 표","use":"여러 열의 값과 수치 비교","avoid":"모바일 단일 작업 목록","class":"ui-table","states":["loading","empty","error","populated"]},
    "C01": {"name":"정보 구역","use":"한 건의 핵심 값을 의미 단위로 확인","avoid":"카드 안 카드 중첩","class":"model-section model-facts","states":["loading","error","populated"]},
    "C02": {"name":"입력 구역","use":"관련 입력 필드를 한 묶음으로 구성","avoid":"읽기 전용 정보","class":"model-form","states":["invalid","disabled","busy"]},
    "C03": {"name":"업무 요약","use":"시작 화면의 최소 상태·건수 요약","avoid":"장식용 통계 카드 반복","class":"model-section","states":["loading","empty","error","populated"]},
    "H01": {"name":"목록·홈 상단","use":"화면 제목과 현재 상태 요약","avoid":"페이지 실행 버튼 배치","class":"model-head","states":["default"]},
    "H02": {"name":"상세·입력 상단","use":"뒤로가기·현재 위치·제목·진행 상태","avoid":"전역 메뉴 혼합","class":"model-head","states":["default"]},
    "N01": {"name":"현재 위치 표시","use":"상세 화면의 상위 목록과 현재 항목 표시","avoid":"주 실행 대체","class":"ui-meta","states":["current"]},
    "N02": {"name":"문서 구역 이동","use":"긴 보고서의 구역·목차 이동","avoid":"앱의 페이지 action","class":"document-nav","states":["current"]},
    "M01": {"name":"아이콘 하단 이동","use":"최상위 화면 간 전역 이동","avoid":"저장·신청 같은 페이지 실행","class":"model-nav","states":["selected","focus-visible"]},
    "M02": {"name":"페이지 하단 실행","use":"상세·입력·검수의 현재 행동","avoid":"전역 메뉴와 한 줄 혼합","class":"model-actions","states":["disabled","busy"]},
    "D01": {"name":"보고서 표제·위계","use":"문서 제목·기준일·섹션 위계","avoid":"웹 앱 버튼·입력 컨트롤","class":"document-header","states":["screen","print"]},
    "D02": {"name":"보고서 표·주석","use":"근거 수치·설명·보류 사항 표현","avoid":"대화형 목록 선택","class":"document-table document-note","states":["screen","print"]}

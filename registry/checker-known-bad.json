{
  "schema_version": "ai-core-checker-known-bad/v1",
  "why": "「검사기가 초록」과 「검사기가 무언가를 잡는다」는 다른 주장이다. 여기 적힌 봉쇄를 하나씩 끄면 그 검사기의 자가진단이 빨개져야 한다(원본: freepasserp4 scripts/check-known-bad.mts · ci-checker-manifest.json).",
  "checkers": {
    "security:secrets": {
      "run": ["scripts/check-secrets.mjs", "--self-test"],
      "marker": "CHECKER BROKEN",
      "blockades": [
        { "name": "Google 키", "file": "shared-services/security/secret-scan.mjs", "disable": ["pattern: /AIza[0-9A-Za-z_-]{35}/g", "pattern: /(?!)/g"] },
        { "name": "개인키", "file": "shared-services/security/secret-scan.mjs", "disable": ["pattern: /-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/g", "pattern: /(?!)/g"] },
        { "name": "서비스계정 private_key", "file": "shared-services/security/secret-scan.mjs", "disable": ["pattern: /\"private_key\"\\s*:\\s*\"-----BEGIN/g", "pattern: /(?!)/g"] },
        { "name": "주민번호", "file": "shared-services/security/secret-scan.mjs", "disable": ["(?:0[1-9]|[12][0-9]|3[01])-[1-4][0-9]{6}(?![0-9])/g", "(?:0[1-9]|[12][0-9]|3[01])-[1-4][0-9]{6}(?![0-9])(?!)/g"] },
        { "name": "가짜 주민번호 무시(오탐 방지)", "file": "shared-services/security/secret-scan.mjs", "disable": ["ignore: match => /-[1-4]234567$/.test(match) || /-[1-4]000000$/.test(match)", "ignore: match => false"] },
        { "name": "예외 표시", "file": "shared-services/security/secret-scan.mjs", "disable": ["if (ALLOW.test(lineText)) return;", "if (false) return;"] },
        { "name": ".env 경로", "file": "shared-services/security/secret-scan.mjs", "disable": ["{ id: 'ENV_FILE', pattern: /(^|\\/)\\.env(?:\\.[^/]+)?$/i,", "{ id: 'ENV_FILE', pattern: /(?!)/i,"] },
        { "name": ".env 견본 무시(오탐 방지)", "file": "shared-services/security/secret-scan.mjs", "disable": ["ignore: path => /\\.(?:example|sample|template)$/i.test(path)", "ignore: path => false"] }
      ]
    },
    "design:react:check": {
      "run": ["scripts/check-design-system-react.mjs", "--self-test"],
      "marker": "CHECKER BROKEN",
      "blockades": [
        { "name": "없는 CSS 변수", "file": "scripts/check-design-system-react.mjs", "disable": ["if (!defined.has(name)) errors.push", "if (false) errors.push"] },
        { "name": "tokens.ts 밖 리터럴 색", "file": "scripts/check-design-system-react.mjs", "disable": ["errors.push(`${rel}: literal color ${literal} outside src/ui/tokens.ts`);", ";"] },
        { "name": "패키지 밖 import", "file": "scripts/check-design-system-react.mjs", "disable": ["errors.push(`${rel}: import '${spec}' leaves the package`);", ";"] },
        { "name": "기록 안 된 파일", "file": "scripts/check-design-system-react.mjs", "disable": ["if (!entry) { errors.push(`${rel}: not recorded in PROVENANCE.json`); continue; }", "if (!entry) { continue; }"] },
        { "name": "EXACT_COPY 원본 대조", "file": "scripts/check-design-system-react.mjs", "disable": ["if (blob !== entry.source_git_blob) errors.push", "if (false) errors.push"] }
      ]
    },
    "canon:guard": {
      "run": ["scripts/canon-guard.mjs", "--self-test"],
      "marker": "CHECKER BROKEN",
      "blockades": [
        { "name": "정본 밖 정의", "file": "src/governance/canonical-guard.mjs", "disable": ["if (count > 0) found.push({ line: line.id, guard: guard.id, path, count });", "if (false) found.push({ line: line.id, guard: guard.id, path, count });"] },
        { "name": "역사자료의 정본 주장", "file": "src/governance/canonical-guard.mjs", "disable": ["if (CLAIM.test(head(text)) && !head(text).includes(NOT_CANONICAL)) {", "if (false) {"] },
        { "name": "진입 파일 갈림", "file": "src/governance/canonical-guard.mjs", "disable": ["if (!identical && !pointer) {", "if (false) {"] },
        { "name": "main 밖 고정", "file": "src/governance/canonical-guard.mjs", "disable": ["if (value.startsWith('${{') || allowed.has(value)) continue;", "continue;"] },
        { "name": "예외 기한", "file": "src/governance/canonical-guard.mjs", "disable": ["if (b.expires && b.expires < today)", "if (false)"] },
        { "name": "묵은 예외", "file": "src/governance/canonical-guard.mjs", "disable": ["for (const b of baseline) if (!seen.has(", "for (const b of []) if (!seen.has("] }
      ]
    }
  }
}

{
  "contract": "ai-core-ui-ux-starter-profiles/v1",
  "version": "1.1.0",
  "default_profile": "freepass-public",
  "shared_behavior_contract": {
    "feature_ids": [
      "action.primary",
      "action.secondary",
      "form.search",
      "data.card",
      "feedback.skeleton",
      "feedback.empty",
      "feedback.alert",
      "navigation.bottom-action",
      "system.responsive",
      "system.focus",
      "system.safe-area-keyboard"
    ],
    "states": ["loading", "empty", "error", "populated"],
    "viewports": [360, 390, 412, 1280, 1440],
    "invariants": [
      "BORDERLESS_ACTIONS_WITH_VISIBLE_INPUT_BOUNDARIES",
      "SEARCH_PRESERVES_QUERY_SELECTION_AND_DRAFT",
      "CARD_ROW_IS_ONE_ACTION_TARGET",
      "TOP_INFORMATION_BOTTOM_ACTION",
      "ONE_PRIMARY_ACTION_PER_BOUNDARY"
    ]
  },
  "profiles": {
    "freepass-public": {
      "label": "FreePass public",
      "description": "Public product, sales and estimate surfaces with comfortable density and responsive card grids.",
      "body_class": "ui-profile-freepass-public",
      "density": "comfortable",
      "behavior_contract": "shared_behavior_contract"
    },
    "freepass-internal": {
      "label": "FreePass internal",
      "description": "Compact operational and data-management surfaces.",
      "body_class": "ui-profile-freepass-internal",
      "density": "compact",
      "behavior_contract": "shared_behavior_contract"
    },
    "freepass-mobile": {
      "label": "FreePass mobile",
      "description": "Field-work surfaces optimized for one task per screen and safe-area bottom actions.",
      "body_class": "ui-profile-freepass-mobile",
      "density": "touch",
      "behavior_contract": "shared_behavior_contract"
    }
  }
}

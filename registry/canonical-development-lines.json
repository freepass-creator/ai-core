{
  "schema": "ai-core-canonical-development-lines/v1",
  "updated_at": "2026-09-26",
  "policy": {
    "one_canonical_line_per_concern": true,
    "historical_assets_must_not_claim_authority": true,
    "superseded_branches_are_not_runtime_authority": true
  },
  "lines": [
    {
      "id": "ui-ux",
      "canonical_entrypoint": "docs/UI_UX_START_HERE.md",
      "canonical_roots": [
        "design-system/",
        "registry/ui-ux-entrypoint.json",
        "registry/ui-ux-features.json",
        "registry/ui-ux-governance.json"
      ],
      "historical_or_noncanonical": [
        "design/claude-v1/"
      ],
      "guards": [
        {
          "id": "css-token-definition",
          "pattern": "^\\s*--[a-z0-9-]+\\s*:",
          "include": [
            "**/*.css"
          ],
          "why": "CSS 사용자 속성(토큰)은 design-system/ 에서만 정의한다. 밖에서 새로 정의하면 토큰 두 벌이 된다."
        }
      ]
    },
    {
      "id": "development-continuity",
      "canonical_entrypoint": "docs/DEVELOPMENT_CONTINUITY_STANDARD.md",
      "canonical_roots": [
        "registry/development-continuity-policy.json",
        "src/development/continuity-audit.mjs",
        "scripts/development-continuity-audit.mjs"
      ],
      "notes": [
        "Repository-wide audit layer: branch budget, age, stale unique branches and actor-owned branches.",
        "PR-level canonical overlap and behind-main checks remain owned by canon:branch."
      ]
    },
    {
      "id": "core-contract",
      "canonical_entrypoint": "docs/CORE_CONTRACT_STANDARD.md",
      "canonical_roots": [
        "contracts/core-",
        "registry/core-contracts.json",
        "src/contracts/"
      ],
      "historical_or_noncanonical": [
        "docs/research/ENGINE_ADAPTER_CROSS_REPO_FINDINGS_2026-09-19.md"
      ]
    },
    {
      "id": "capability-runtime",
      "canonical_entrypoint": "src/engine/capability-engine.mjs",
      "canonical_roots": [
        "src/engine/capability-engine.mjs",
        "src/engine/adapter-contract.mjs",
        "src/engine/project-runtime.mjs"
      ],
      "notes": [
        "src/engine/adapter-contract.mjs is a runtime invocation envelope, not a second provider adapter standard"
      ]
    },
    {
      "id": "workflow",
      "canonical_entrypoint": "docs/workflow/WORKFLOW_CONSTITUTION.md",
      "canonical_roots": [
        "src/workflow/",
        "registry/workflows.json",
        "registry/workflow-progressions.json",
        "registry/workflow-projections.json",
        "registry/workflow-recovery-policies.json"
      ]
    },
    {
      "id": "integration-connectors",
      "canonical_entrypoint": "devcenter/hubs/integration/README.md",
      "canonical_roots": [
        "devcenter/contracts/integration-connector.schema.json",
        "devcenter/hubs/integration/connectors.json"
      ]
    },
    {
      "id": "aiops-import",
      "canonical_entrypoint": "aiops/README.md",
      "canonical_roots": [
        "aiops/"
      ],
      "historical_or_noncanonical": [
        {
          "path": "aiops/docs/CONTROL_PLANE.md",
          "marker_in": "aiops/README.md",
          "reason": "exact-copy 원본이라 파일에 표시를 달 수 없다 — README 의 정본 경계 절이 가리킨다"
        }
      ],
      "notes": [
        "Imported AIOps documents retain provenance only; they do not override AI Core root governance"
      ]
    }
  ],
  "branch_families": {
    "historical_engine_lines": [
      "feature/orchestrator-v0.1",
      "feature/cognitive-runtime-v0.6",
      "feat/capability-engine-v1"
    ],
    "historical_ui_lines": [
      "codex/ui-ux-new-project-starter",
      "codex/ui-ux-starter-completion",
      "codex/ui-ux-starter-runtime",
      "work/gpt/ui-ux-universal-contract-v1",
      "claude/erp-platform-ui-ux-hvfyfa"
    ],
    "historical_connector_lines": [
      "feat/connector-registry-v1"
    ],
    "review_before_retire": []
  },
  "repository_guards": {
    "entry_files": {
      "canonical": "AGENTS.md",
      "mirrors": [
        "CLAUDE.md",
        "GEMINI.md"
      ],
      "why": "AI 가 처음 읽는 지시문은 한 벌이다. 나머지는 똑같거나 AGENTS.md 를 가리키는 한 줄이다."
    },
    "workflow_refs": {
      "allow": [
        "main"
      ],
      "why": "운영·예약 작업은 main 에서만 돈다. main 밖 커밋·가지를 checkout 하면 두 번째 계보가 운영을 쥔다(freepasserp4 발행기 사례)."
    },
    "pull_request": {
      "max_behind_main": 30,
      "single_open_pr_per_canonical_path": true,
      "why": "묵은 가지·같은 정본을 동시에 고치는 PR 이 갈림의 원인이다.",
      "allowed_head_patterns": [
        "^work/[a-z0-9._-]+/[a-z0-9._-]+$",
        "^dependabot/",
        "^renovate/"
      ],
      "forbidden_actor_prefixes": [
        "gpt/",
        "claude/",
        "codex/",
        "cursor/",
        "gemini/",
        "work/gpt/",
        "work/claude/",
        "work/codex/",
        "work/cursor/",
        "work/gemini/"
      ],
      "legacy_head_exceptions": [
        {
          "branch": "gpt/activation-authority-contract-20260925",
          "expires": "2026-10-07"
        },
        {
          "branch": "claude/erp-platform-ui-ux-hvfyfa",
          "expires": "2026-10-07"
        },
        {
          "branch": "integration/shadow-freshness",
          "expires": "2026-10-07"
        },
        {
          "branch": "integration/docshub-templates",
          "expires": "2026-10-07"
        },
        {
          "branch": "docs/claude-codex-desk",
          "expires": "2026-10-07"
        },
        {
          "branch": "claude/ai-core-integration-standardization-ntmoli",
          "expires": "2026-10-07",
          "reason": "이 Claude 세션에 배정된 가지 이름이라 세션이 바꿀 수 없다. 다음 세션부터 work/<project>/<work-id> 로 연다."
        }
      ]
    }
  },
  "baseline": [
    {
      "guard": "css-token-definition",
      "path": "devcenter/portal/app/globals.css",
      "expires": "2026-10-31",
      "reason": "DevCenter 포털 로컬 변수 — design-system 토큰으로 옮길 때까지"
    },
    {
      "guard": "css-token-definition",
      "path": "examples/claude/claude-v1.css",
      "expires": "2026-10-31",
      "reason": "claude-v1 역사 예시 — 역사자료로 옮기거나 지운다"
    }
  ]
}

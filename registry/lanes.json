    },
    {
      "pattern": "^docs/(coordination|episodes|research|evidence|audits|handoffs|reviews|intake|improvement)/",
      "lane": "F",
      "rule": "C",
      "note": "일의 «기록과 증거». 규율 lane 이 관문과 함께 소유한다"

    "date": "YYYY-MM-DD",
    "datetime": "RFC3339 timestamp with timezone; canonical persisted time normalized to UTC",
    "money": "{amount_minor,currency}; currency is ISO-4217 alpha-3",
    "percentage": "percentage points; 10 means 10 percent, provider ratios belong in adapters",

  "projections": [
    {
      "projection_id": "freepass-admin.application.status",
      "version": "0.1.0",
      "adoption_status": "SHADOW",
      "owner": "D-session-workflow-standard",
      "description": "FreePass Admin ApplicationStatus is derived from authoritative cancellation lifecycle plus independent progress facts. RECEIVED/CONTRACTED/DELIVERED are projections, not independently writable lifecycle states. Source-side SHADOW parity is verified in FreePass Admin CI.",
      "workflow_id": "freepass-admin.application-lifecycle",
      "output": {
        "projection_ref": "application.status",
        "type": "string",
        "allowed_values": [
          "RECEIVED",
          "CONTRACTED",
          "DELIVERED",
          "CANCELLED"
        ]
      },
      "rules": [
        {
          "rule_id": "freepass-admin.application.status.cancelled",
          "priority": 10,
          "all": [
            {
              "kind": "STATE_EQUALS",
              "axis_id": "lifecycle",
              "value": "CANCELLED"
            }
          ],
          "result": "CANCELLED",
          "description": "Cancellation is authoritative and sticky."
        },
        {
          "rule_id": "freepass-admin.application.status.delivered",
          "priority": 20,
          "all": [
            {
              "kind": "FACT_EQUALS",
              "fact_id": "application.delivery-completed",
              "value": true
            }
          ],
          "result": "DELIVERED",
          "description": "Delivery completion derives DELIVERED regardless of document/balance flags."
        },
        {
          "rule_id": "freepass-admin.application.status.contracted",
          "priority": 30,
          "all": [
            {
              "kind": "FACT_EQUALS",
              "fact_id": "application.contract-completed",
              "value": true
            }
          ],
          "result": "CONTRACTED",
          "description": "Contract completion derives CONTRACTED while not cancelled/delivered."
        }
      ],
      "default_result": "RECEIVED",

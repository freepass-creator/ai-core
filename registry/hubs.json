{
  "version": 1,
  "contract": "devcenter-hub-registry/v1",
  "control_plane": {
    "id": "control-plane",
    "is_hub": false,
    "paths": [
      "operations",
      "standards",
      "registry.json",
      "ssot",
      "engine",
      "runs"
    ]
  },
  "hubs": [
    {
      "id": "design",
      "name": "Design Hub",
      "primary_path": "hubs/design",
      "backing_paths": ["design"],
      "responsibilities": ["ui-ux", "tokens", "components", "patterns", "screen-page-spec", "visual-qa"],
      "upstream": ["ai-core-ui-ux-contract"],
      "representative_sources": ["devcenter/design", "project-design-assets"]
    },
    {
      "id": "data",
      "name": "Data Hub",
      "primary_path": "hubs/data",
      "backing_paths": ["ssot"],
      "responsibilities": ["schema", "ssot", "authority", "lineage", "provenance", "data-quality", "projection", "migration", "distribution", "audit-receipt"],
      "upstream": ["ai-core-core-data-contract"],
      "representative_sources": ["freepass-creator/freepass-data"]
    },
    {
      "id": "document",
      "name": "Document Hub",
      "primary_path": "hubs/document",
      "backing_paths": [],
      "responsibilities": ["templates", "reports", "proposals", "contracts", "terms", "pdf", "ppt", "document-rendering"],
      "upstream": ["design-hub"],
      "representative_sources": ["freepass-creator/docshub"]
    },
    {
      "id": "engineering",
      "name": "Engineering Hub",
      "primary_path": "hubs/engineering",
      "backing_paths": ["capabilities/shared"],
      "responsibilities": ["sdk", "library", "repository", "adapter", "provider", "frontend-pattern", "backend-pattern", "starter"],
      "upstream": ["ai-core-contract"],
      "representative_sources": ["project-verified-common-code"]
    },
    {
      "id": "integration",
      "name": "Integration Hub",
      "primary_path": "hubs/integration",
      "backing_paths": ["capabilities/integrations"],
      "responsibilities": ["firebase", "google", "github", "external-api", "connector", "webhook", "auth-boundary"],
      "upstream": ["ai-core-event-error-result-workflow-contract"],
      "representative_sources": ["project-verified-connectors"]
    },
    {
      "id": "quality",
      "name": "Quality Hub",
      "primary_path": "hubs/quality",
      "backing_paths": ["quality/conformance", "quality/testing"],
      "responsibilities": ["conformance", "testing", "regression", "accessibility", "performance", "security-qa", "visual-qa-evidence"],
      "upstream": ["all-hubs"],
      "representative_sources": ["inspection-evidence", "project-test-evidence"]
    },
    {
      "id": "delivery",
      "name": "Delivery Hub",
      "primary_path": "hubs/delivery",
      "backing_paths": ["quality/release-recovery"],
      "responsibilities": ["build", "deploy", "release", "version", "environment", "rollback", "recovery", "runtime-evidence"],
      "upstream": ["quality-hub", "ai-core-release-recovery-contract"],
      "representative_sources": ["project-ci-cd"]
    }
  ]
}

  "policy": {
    "claim_key": "<repository>@<subject_revision>::<scope>",
    "live_claim": "state=ACTIVE and lease_until > observed_at",
    "duplicate_rule": "If another live claim conflicts by canonical scope on the same repository revision, do not inspect or mutate that overlapping work item.",
    "completed_rule": "If the same claim_key is already COMPLETED and the repository subject revision is unchanged, do not repeat the audit.",
    "optimistic_lock": "Every mutation must use the current GitHub blob SHA. On SHA conflict, refetch the registry and re-evaluate before retrying.",
    "revision_guard": "Before material writes, re-check the repository head. If it moved, abandon or supersede the old claim and claim the new revision.",
    "canonical_boundary": "Claims coordinate A-session research only and never change B/C/D canonical standards.",
    "scope_policy": {
      "canonical_scopes": [
        "repo-rescan",
        "runtime-evidence:<surface>",
        "migration-gap:<finding-id>",
        "routing:<finding-id>",
        "coordination:<topic>"
      ],
      "active_scope_requirement": "New ACTIVE claims must use a canonical scope. Historical terminal claims may retain legacy scopes for audit history.",
      "live_conflict": [
        "same canonical scope conflicts on the same repository revision",
        "repo-rescan conflicts with runtime-evidence:* on the same repository revision",
        "repo-rescan conflicts with migration-gap:* on the same repository revision",
        "routing:* and coordination:* only conflict with the same exact scope"
      ],
      "completion_rule": "COMPLETED suppresses only the same exact claim scope. Runtime/deployment evidence may change independently without a repository revision change."
    },
    "owner_policy": {
      "source": "--owner or AI_CORE_A_SESSION_ID",
      "format": "A-session-<stable-unique-id>",
      "forbidden": [
        "A_SESSION",
        "A-session-current-chat",
        "A-session-default",
        "A-session-generic",
        "underspecified A-session-1"
      ],
      "mutation_binding": [
        "claim",
        "renew",
        "complete",
        "abandon",
        "supersede"
      ],
      "exception": "Automated expired-lease reaping may abandon an already expired ACTIVE claim without owner authority.",
      "one_live_claim_per_owner": true,
      "owner_busy_result": "SKIP_OWNER_BUSY",
      "reason": "A session is a single active worker. Reusing one owner across concurrent tasks is treated as identity collision, not parallel capacity."
    },
    "completion_revision_guard": {
      "guarded_scopes": [
        "repo-rescan",
        "runtime-evidence:*",
        "migration-gap:*"
      ],
      "rule": "Before COMPLETED, resolve the repository current default-branch head and require it to equal subject_revision.",
      "moved_head": "If current head differs, do not complete. Transition the claim to SUPERSEDED with SUBJECT_HEAD_MOVED and record superseded_by_revision.",
      "lookup_failure": "If current head cannot be resolved, fail closed with SUBJECT_HEAD_CHECK_FAILED.",
      "exempt_scopes": [
        "routing:*",
        "coordination:*"
      ],
      "reason": "Routing and AI Core coordination writes can legitimately mutate AI Core main while the coordination task is in progress."
    },
    "evidence_contract": {
      "current": "v2",
      "active_from": "2026-09-20T02:35:00Z",
      "legacy_rule": "Claims created before active_from may complete under the historical nonempty evidence_refs rule.",
      "allowed_refs": [
        "subject:<owner/repo>@<40sha>",
        "commit:<owner/repo>@<40sha>",
        "ci:<owner/repo>#<run-id>@<40sha>"
      ],
      "guarded_scope_requirement": "repo-rescan/runtime-evidence/migration-gap completion requires exact subject:<repository>@<subject_revision>.",
      "proof_requirement": "Every v2 completion requires at least one commit or ci ref.",
      "remote_verification": "commit/subject refs must resolve; ci refs must exist, match head_sha, and conclude success.",
      "verification_receipt": {
        "required": true,
        "verifiers": [
          "github-remote-v2",
          "github-connector-v2"
        ],
        "digest": "sha256(JSON.stringify(evidence_refs))"
      }
    }
  },

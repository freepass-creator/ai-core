{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "es2022"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "react",
      "react-dom",
      "node"
    ]
  },
  "files": [
    "app/center.tsx",
    "app/evidence.tsx",
    "app/primitives.tsx",
    "app/styles-library.tsx"
  ]
}

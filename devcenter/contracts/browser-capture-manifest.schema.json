{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/browser-capture-manifest.schema.json",
  "title": "Development Center Browser Capture Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "visual_plan_ref",
    "adapter",
    "captures",
    "result",
    "captured_at"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-browser-capture-manifest/v1"
    },
    "visual_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "browser"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "browser_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "captures": {
      "type": "array",
      "minItems": 1
    },
    "result": {
      "type": "object"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

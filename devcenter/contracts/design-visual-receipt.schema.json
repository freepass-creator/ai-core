{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/design-visual-receipt.schema.json",
  "title": "Development Center Design Visual Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "receipt_id",
    "subject",
    "visual_plan_ref",
    "capture_manifest_ref",
    "reviewer",
    "case_results",
    "result",
    "created_at"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-design-visual-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^dvr_[a-f0-9]{24}$"
    },
    "subject": {
      "type": "object"
    },
    "visual_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "capture_manifest_ref": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "AI_VISUAL_REVIEW",
            "HUMAN_REVIEW"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "case_results": {
      "type": "array",
      "minItems": 1
    },
    "result": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

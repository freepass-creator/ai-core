{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/design-visual-receipt.schema.json",
  "title": "Development Center Design Visual Receipt Core Extension v1",
  "description": "Specialized payload for core-receipt/v1. Common receipt fields are defined only by the AI Core receipt schema.",
  "allOf": [
    {
      "$ref": "https://schemas.freepass.ai/core/receipt/v1"
    },
    {
      "type": "object",
      "required": [
        "receipt_kind",
        "payload"
      ],
      "properties": {
        "receipt_kind": {
          "const": "hub.design-visual"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy_contract",
            "subject",
            "visual_plan_ref",
            "capture_manifest_ref",
            "reviewer",
            "case_results",
            "result"
          ],
          "properties": {
            "legacy_contract": {
              "const": "devcenter-design-visual-receipt/v1"
            },
            "subject": {
              "type": "object"
            },
            "visual_plan_ref": {
              "type": "string",
              "minLength": 1
            },
            "capture_manifest_ref": {
              "type": "string",
              "minLength": 1
            },
            "reviewer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "AI_VISUAL_REVIEW",
                    "HUMAN_REVIEW"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "case_results": {
              "type": "array",
              "minItems": 1
            },
            "result": {
              "type": "object"
            }
          }
        }
      }
    }
  ]
}

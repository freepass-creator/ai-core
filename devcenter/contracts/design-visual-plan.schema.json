{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/design-visual-plan.schema.json",
  "title": "Development Center Design Visual Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "subject",
    "design_plan_ref",
    "core_revision",
    "preview_origin",
    "captures",
    "review_requirements",
    "result"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-design-visual-plan/v1"
    },
    "subject": {
      "type": "object"
    },
    "design_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "core_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "preview_origin": {
      "type": "string",
      "pattern": "^https?://"
    },
    "captures": {
      "type": "array",
      "minItems": 1
    },
    "review_requirements": {
      "type": "object"
    },
    "result": {
      "type": "object"
    }
  }
}

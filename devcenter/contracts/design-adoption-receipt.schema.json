{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/design-adoption-receipt.schema.json",
  "title": "Development Center Design Adoption Receipt Core Extension v1",
  "description": "Specialized payload for core-receipt/v1. Common receipt fields are defined only by the AI Core receipt schema.",
  "allOf": [
    {
      "$ref": "https://schemas.freepass.ai/core/receipt/v1"
    },
    {
      "type": "object",
      "required": [
        "receipt_kind",
        "payload"
      ],
      "properties": {
        "receipt_kind": {
          "const": "hub.design-adoption"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy_contract",
            "subject",
            "authority",
            "ai_core",
            "design_hub_revision",
            "checks",
            "result",
            "source_blobs"
          ],
          "properties": {
            "legacy_contract": {
              "const": "devcenter-design-adoption-receipt/v1"
            },
            "subject": {
              "type": "object"
            },
            "authority": {
              "type": "object"
            },
            "ai_core": {
              "type": "object"
            },
            "design_hub_revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "checks": {
              "type": "array",
              "minItems": 1
            },
            "result": {
              "type": "object"
            },
            "source_blobs": {
              "type": "object"
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/design-adoption-receipt.schema.json",
  "title": "Development Center Design Adoption Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "receipt_id",
    "subject",
    "authority",
    "ai_core",
    "design_hub_revision",
    "checks",
    "result",
    "source_blobs",
    "created_at"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-design-adoption-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^dar_[a-f0-9]{24}$"
    },
    "subject": {
      "type": "object"
    },
    "authority": {
      "type": "object"
    },
    "ai_core": {
      "type": "object"
    },
    "design_hub_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "checks": {
      "type": "array",
      "minItems": 1
    },
    "result": {
      "type": "object"
    },
    "source_blobs": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

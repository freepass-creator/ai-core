{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/design-job.schema.json",
  "title": "Development Center Design Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "target",
    "surface",
    "product_profile",
    "feature_ids",
    "composition",
    "quality"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-design-job/v1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository",
        "revision"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "viewports"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "WEB",
            "MOBILE_WEB",
            "MOBILE_APP",
            "ERP",
            "DOCUMENT"
          ]
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 240
          }
        }
      }
    },
    "product_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_profile_ref",
        "ui_profile_ref",
        "density",
        "locale",
        "direction"
      ],
      "properties": {
        "brand_profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "density": {
          "enum": [
            "COMPACT",
            "STANDARD",
            "COMFORTABLE"
          ]
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "direction": {
          "enum": [
            "LTR",
            "RTL"
          ]
        },
        "ui_profile_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "feature_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "composition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "feature_id",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "HEADER",
              "NAVIGATION",
              "CONTENT",
              "DATA",
              "FORM",
              "FEEDBACK",
              "ACTION",
              "OVERLAY",
              "FOOTER"
            ]
          },
          "feature_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "approved_design_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_runtime_implementation",
        "require_visual_receipt"
      ],
      "properties": {
        "require_runtime_implementation": {
          "type": "boolean"
        },
        "require_visual_receipt": {
          "type": "boolean"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/data-receipt.schema.json",
  "title": "Development Center Data Hub Receipt Core Extension v1",
  "description": "Specialized payload for core-receipt/v1. Common receipt fields are defined only by the AI Core receipt schema.",
  "allOf": [
    {
      "$ref": "https://schemas.freepass.ai/core/receipt/v1"
    },
    {
      "type": "object",
      "required": [
        "receipt_kind",
        "payload"
      ],
      "properties": {
        "receipt_kind": {
          "const": "hub.data"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy_contract",
            "subject",
            "scope",
            "checks",
            "result"
          ],
          "properties": {
            "legacy_contract": {
              "const": "devcenter-data-receipt/v1"
            },
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project_id",
                "repository",
                "revision"
              ],
              "properties": {
                "project_id": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string",
                  "pattern": "^[^/]+/[^/]+$"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              }
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "domain",
                "claims",
                "exclusions"
              ],
              "properties": {
                "domain": {
                  "type": "string",
                  "minLength": 1
                },
                "claims": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "exclusions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "checks": {
              "type": "array",
              "minItems": 1
            },
            "result": {
              "type": "object"
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/document-receipt.schema.json",
  "title": "Development Center Document Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "receipt_id",
    "subject",
    "template",
    "source",
    "artifacts",
    "checks",
    "result",
    "created_at"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-document-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^doc_[a-f0-9]{24}$"
    },
    "subject": {
      "type": "object"
    },
    "template": {
      "type": "object"
    },
    "source": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1
    },
    "result": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

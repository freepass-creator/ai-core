{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/document-receipt.schema.json",
  "title": "Development Center Document Receipt Core Extension v1",
  "description": "Specialized payload for core-receipt/v1. Common receipt fields are defined only by the AI Core receipt schema.",
  "allOf": [
    {
      "$ref": "https://schemas.freepass.ai/core/receipt/v1"
    },
    {
      "type": "object",
      "required": [
        "receipt_kind",
        "payload"
      ],
      "properties": {
        "receipt_kind": {
          "const": "hub.document"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy_contract",
            "subject",
            "template",
            "source",
            "artifacts",
            "checks",
            "result"
          ],
          "properties": {
            "legacy_contract": {
              "const": "devcenter-document-receipt/v1"
            },
            "subject": {
              "type": "object"
            },
            "template": {
              "type": "object"
            },
            "source": {
              "type": "object"
            },
            "artifacts": {
              "type": "array",
              "minItems": 1
            },
            "checks": {
              "type": "array",
              "minItems": 1
            },
            "result": {
              "type": "object"
            }
          }
        }
      }
    }
  ]
}

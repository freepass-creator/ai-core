{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/delivery-receipt.schema.json",
  "title": "Development Center Delivery Receipt Core Extension v1",
  "description": "Specialized payload for core-receipt/v1. Common receipt fields are defined only by the AI Core receipt schema.",
  "allOf": [
    {
      "$ref": "https://schemas.freepass.ai/core/receipt/v1"
    },
    {
      "type": "object",
      "required": [
        "receipt_kind",
        "payload"
      ],
      "properties": {
        "receipt_kind": {
          "const": "hub.delivery"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy_contract",
            "subject",
            "target",
            "quality_receipts",
            "build",
            "deployment",
            "smoke",
            "rollback",
            "result"
          ],
          "properties": {
            "legacy_contract": {
              "const": "devcenter-delivery-receipt/v1"
            },
            "subject": {
              "type": "object"
            },
            "target": {
              "type": "object"
            },
            "quality_receipts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "build": {
              "type": "object"
            },
            "deployment": {
              "type": "object"
            },
            "smoke": {
              "type": "object"
            },
            "rollback": {
              "type": "object"
            },
            "result": {
              "type": "object"
            }
          }
        }
      }
    }
  ]
}

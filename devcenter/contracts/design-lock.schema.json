{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/design-lock.schema.json",
  "title": "Development Center Design Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "lock_id",
    "subject",
    "design_plan_ref",
    "core_revision",
    "approval",
    "source_refs",
    "created_at"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-design-lock/v1"
    },
    "lock_id": {
      "type": "string",
      "pattern": "^dl_[a-f0-9]{24}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository",
        "revision",
        "surface_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "surface_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "design_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "core_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approved_by",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "const": "APPROVED"
        },
        "approved_by": {
          "enum": [
            "USER",
            "AUTHORIZED_REVIEWER"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "previous_lock_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

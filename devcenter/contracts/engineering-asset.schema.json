{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/engineering-asset.schema.json",
  "title": "Development Center Engineering Asset Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "assets"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-engineering-assets/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "source",
          "interface",
          "verification",
          "lifecycle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "SCRIPT",
              "MODULE",
              "SDK",
              "PATTERN",
              "REPOSITORY",
              "ADAPTER",
              "PROVIDER",
              "STARTER"
            ]
          },
          "status": {
            "enum": [
              "CANDIDATE",
              "ACTIVE",
              "DEPRECATED",
              "RETIRED"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "revision",
              "path",
              "blob_sha"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "pattern": "^[^/]+/[^/]+$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "blob_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          },
          "interface": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputs",
              "outputs",
              "side_effects"
            ],
            "properties": {
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "side_effects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "supersedes",
              "superseded_by",
              "rollback_ref"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "supersedes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "superseded_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rollback_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}

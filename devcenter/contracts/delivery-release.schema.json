{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/delivery-release.schema.json",
  "title": "Development Center Delivery Release v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "subject",
    "target",
    "quality",
    "build",
    "release",
    "rollback"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-delivery-release/v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository",
        "revision"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "provider",
        "application"
      ],
      "properties": {
        "environment": {
          "enum": [
            "PREVIEW",
            "STAGING",
            "PRODUCTION"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "application": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_receipts"
      ],
      "properties": {
        "required_receipts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "approval_required"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval_required": {
          "type": "boolean"
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "commands",
        "last_known_good_ref"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "REDEPLOY_PREVIOUS",
            "PROMOTE_PREVIOUS",
            "ROLLBACK_COMMAND",
            "MANUAL_PROCEDURE"
          ]
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "last_known_good_ref": {
          "type": "string",
          "minLength": 1
        },
        "irreversible_effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

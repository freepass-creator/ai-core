{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/design-visual-job.schema.json",
  "title": "Development Center Design Visual Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "design_plan_ref",
    "preview",
    "cases",
    "capture"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-design-visual-job/v1"
    },
    "design_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^https?://"
        },
        "health_path": {
          "type": "string",
          "default": "/"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "state",
          "locale",
          "direction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-_.][a-z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "minLength": 2
          },
          "direction": {
            "enum": [
              "LTR",
              "RTL"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "settle_ms"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "minimum": 320,
          "maximum": 5000
        },
        "settle_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    }
  }
}

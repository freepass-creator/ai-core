{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teamjpk.local/devcenter/contracts/document-job.schema.json",
  "title": "Development Center Document Job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "subject",
    "template_id",
    "content_ref",
    "output",
    "quality"
  ],
  "properties": {
    "contract": {
      "const": "devcenter-document-job/v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository",
        "revision"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "content_ref": {
      "type": "string",
      "minLength": 1
    },
    "brand_profile_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "orientation"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "HTML",
              "PDF",
              "PPTX",
              "PNG"
            ]
          }
        },
        "orientation": {
          "enum": [
            "PORTRAIT",
            "LANDSCAPE"
          ]
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_accuracy",
        "visual_review"
      ],
      "properties": {
        "content_accuracy": {
          "type": "boolean"
        },
        "visual_review": {
          "type": "boolean"
        }
      }
    }
  }
}

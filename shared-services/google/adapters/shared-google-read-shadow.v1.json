  },
  "compatibility": {
    "port_versions": [
      "v1"
    ],
    "engine_versions": []
  },
  "mapping": [
    {
      "canonical_field": "request.url",
      "provider_field": "url",
      "transformation": "Validate through assertAllowedGoogleApiUrl; only Sheets v4 and Drive v3 read surfaces pass."
    },
    {
      "canonical_field": "request.method",
      "provider_field": "method",
      "transformation": "Uppercase and allow GET, HEAD or OPTIONS only."
    },
    {
      "canonical_field": "auth.bearer_token",
      "provider_field": "Authorization",
      "transformation": "Inject caller-supplied token as Bearer; adapter never reads credential files or mints tokens."
    }
  ],
  "side_effects": false,
  "idempotency": "NOT_APPLICABLE",
  "retry_policy": {
    "max_attempts": 7,
    "backoff": "FIXED",
    "retryable_error_codes": [
      "GOOGLE_API_HTTP_ERROR"
    ]
  },
  "timeout_ms": 300000,
  "auth_boundary": "Caller supplies an already-acquired bearer token. Credential loading, delegated identity and token minting remain outside shared-services.",
  "data_classification": [
    "INTERNAL",
    "CONFIDENTIAL",
    "PII",
    "FINANCIAL"
  ],
  "failure_mapping": [
    {
      "provider_code": "401",
      "core_code": "GOOGLE_API_HTTP_ERROR"
    },
    {
      "provider_code": "403",
      "core_code": "GOOGLE_API_HTTP_ERROR"
    },
    {
      "provider_code": "404",
      "core_code": "GOOGLE_API_HTTP_ERROR"
    },
    {
      "provider_code": "429",
      "core_code": "GOOGLE_API_HTTP_ERROR"
    },
    {
      "provider_code": "500",
      "core_code": "GOOGLE_API_HTTP_ERROR"
    },
    {
      "provider_code": "503",
      "core_code": "GOOGLE_API_HTTP_ERROR"
    }
  ],
  "health_check": "SHADOW only: schema + unit/negative/retry tests. No live Google call and no consumer cutover.",
  "verification_profile": [
    "core-adapter-schema",
    "google-url-allowlist-negative-tests",
    "read-method-only-tests",
    "fixed-retry-tests",
    "authorization-header-nonoverride-test"
  ]

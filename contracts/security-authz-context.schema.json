{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/security/authz-context/v1",
  "title": "AI Core Security Authorization Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "principal",
    "action",
    "resource",
    "risk_class",
    "correlation_id"
  ],
  "properties": {
    "schema_version": {"const": "security-authz-context/v1"},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "principal_type", "authentication_subject_id", "role_ids", "org_id", "scopes"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1},
        "principal_type": {"enum": ["HUMAN", "SERVICE", "AI_ACTOR", "SYSTEM"]},
        "authentication_subject_id": {"type": ["string", "null"]},
        "role_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "org_id": {"type": ["string", "null"]},
        "scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "action": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]+$"},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "owner_org_id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": ["string", "null"]},
        "owner_org_id": {"type": ["string", "null"]}
      }
    },
    "risk_class": {
      "enum": [
        "READ_ONLY",
        "LOCAL_MUTATION",
        "REVERSIBLE_EXTERNAL_MUTATION",
        "PRIVILEGED_MUTATION",
        "IRREVERSIBLE_EXTERNAL_ACTION"
      ]
    },
    "correlation_id": {"type": "string", "minLength": 1}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/workflow-recovery-policy.schema.json",
  "title": "AI Core Workflow Recovery Policy Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "policies"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "policies": {
      "type": "array",
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "files"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "blob_sha"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id", "adoption_status", "evidence_level", "source_projects",
        "identity", "execution_paths", "success_reconciliation", "recovery_eligibility",
        "cursor", "ambiguous_outcome_action", "contract_dependency", "source_authority"
      ],
      "properties": {
        "policy_id": { "type": "string", "pattern": "^workflow\\.[a-z0-9][a-z0-9.-]*$" },
        "adoption_status": { "enum": ["PILOT", "COMMON_ADOPTED", "DEPRECATED"] },
        "evidence_level": { "enum": ["PROJECT_VERIFIED", "CROSS_PROJECT_VERIFIED", "COMMON_ADOPTED"] },
        "source_projects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "description": { "type": "string" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "dimensions", "shared_across_paths"],
          "properties": {
            "scope": { "const": "LOGICAL_EXECUTION" },
            "dimensions": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "shared_across_paths": { "const": true }
          }
        },
        "execution_paths": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["NATIVE", "FALLBACK", "DOWNSTREAM", "MANUAL_RECOVERY"] }
        },
        "success_reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_fallback", "success_suppresses_fallback", "evidence_sources"],
          "properties": {
            "before_fallback": { "const": true },
            "success_suppresses_fallback": { "const": true },
            "evidence_sources": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "enum": ["NATIVE_EXECUTION", "RECOVERY_HISTORY", "DOWNSTREAM_TERMINAL_EVIDENCE", "EXTERNAL_AUTHORITY"] }
            }
          }
        },
        "recovery_eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slot_due", "no_success_evidence", "no_successful_prior_recovery"],
          "properties": {
            "slot_due": { "const": true },
            "no_success_evidence": { "const": true },
            "no_successful_prior_recovery": { "const": true }
          }
        },
        "cursor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["monotonic", "replay_forbidden_after_success"],
          "properties": {
            "monotonic": { "const": true },
            "replay_forbidden_after_success": { "const": true }
          }
        },
        "ambiguous_outcome_action": { "const": "HOLD" },
        "contract_dependency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity_owner", "identity_contract_status"],
          "properties": {
            "identity_owner": { "const": "C" },
            "identity_contract_status": { "enum": ["PENDING", "BOUND"] }
          }
        },
        "source_authority": { "$ref": "#/$defs/sourceAuthority" }
      }
    }
  }
}

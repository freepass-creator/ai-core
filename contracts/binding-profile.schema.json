{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engine Adapter Binding Profile",
  "type": "object",
  "required": ["profile_id", "project_id", "environment", "subject_revision", "engine_bindings", "verification_state"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 3},
    "project_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "subject_revision": {"type": "string", "minLength": 1},
    "engine_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["engine_id", "engine_version", "ports"],
        "properties": {
          "engine_id": {"type": "string"},
          "engine_version": {"type": "string"},
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["port_id", "adapter_id"],
              "properties": {
                "port_id": {"type": "string"},
                "adapter_id": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "config_refs": {"type": "array", "items": {"type": "string"}},
    "required_approvals": {"type": "array", "items": {"type": "string"}},
    "verification_state": {"type": "string", "enum": ["NOT_RUN", "PARTIAL", "PASSED_WITHIN_SCOPE", "FAILED", "STALE"]}
  },
  "additionalProperties": true
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/ui-ux-governance.schema.json",
  "title": "AI Core UI UX Governance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "feature_registry",
    "exceptions",
    "deprecations"
  ],
  "properties": {
    "contract": {
      "const": "ai-core-ui-ux-governance/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "feature_registry": {
      "const": "registry/ui-ux-features.json"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "feature_id",
          "product",
          "reason",
          "owner",
          "evidence",
          "review_on",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^uxe-[a-z0-9-]+$"
          },
          "feature_id": {
            "type": "string",
            "minLength": 2
          },
          "product": {
            "type": "string",
            "minLength": 2
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "owner": {
            "type": "string",
            "minLength": 2
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            },
            "uniqueItems": true
          },
          "review_on": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "EXPIRED",
              "RESOLVED"
            ]
          }
        }
      }
    },
    "deprecations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "deprecated_item",
          "kind",
          "replacement",
          "deprecated_revision",
          "review_on",
          "consumer_discovery",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^uxd-[a-z0-9-]+$"
          },
          "deprecated_item": {
            "type": "string",
            "minLength": 2
          },
          "kind": {
            "enum": [
              "feature",
              "token",
              "selector",
              "pattern",
              "document"
            ]
          },
          "replacement": {
            "type": [
              "string",
              "null"
            ]
          },
          "deprecated_revision": {
            "type": "string",
            "minLength": 7
          },
          "review_on": {
            "type": "string",
            "format": "date"
          },
          "consumer_discovery": {
            "type": "string",
            "minLength": 5
          },
          "status": {
            "enum": [
              "DEPRECATED",
              "READY_TO_REMOVE",
              "REMOVED"
            ]
          }
        }
      }
    }
  }
}

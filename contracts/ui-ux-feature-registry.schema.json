{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/ui-ux-feature-registry.schema.json",
  "title": "AI Core Universal UI/UX Feature Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "normative_source",
    "global_rules",
    "profiles",
    "features"
  ],
  "properties": {
    "contract": {
      "const": "ai-core-ui-ux-feature-registry/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "normative_source": {
      "const": "docs/SCREEN_DESIGN_STANDARD.md"
    },
    "global_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariants",
        "product_owned",
        "internationalization",
        "exceptions"
      ],
      "properties": {
        "invariants": {
          "$ref": "#/$defs/stringList"
        },
        "product_owned": {
          "$ref": "#/$defs/stringList"
        },
        "internationalization": {
          "$ref": "#/$defs/stringList"
        },
        "exceptions": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rules",
          "verification"
        ],
        "properties": {
          "rules": {
            "$ref": "#/$defs/stringList"
          },
          "verification": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 40,
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "title",
        "kind",
        "adoption",
        "profiles",
        "required_states",
        "rules",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "family": {
          "enum": [
            "action",
            "form",
            "navigation",
            "data",
            "feedback",
            "overlay",
            "workflow",
            "integration",
            "system"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "kind": {
          "enum": [
            "component",
            "pattern",
            "workflow",
            "engine",
            "adapter",
            "surface"
          ]
        },
        "adoption": {
          "const": "REQUIRED"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "required_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          },
          "uniqueItems": true
        },
        "rules": {
          "$ref": "#/$defs/stringList"
        },
        "engine_binding": {
          "type": "string",
          "minLength": 2
        },
        "adapter_binding": {
          "type": "string",
          "minLength": 2
        },
        "verification": {
          "$ref": "#/$defs/stringList"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "refs"
      ],
      "properties": {
        "level": {
          "enum": [
            "NORMATIVE",
            "PLATFORM_CONSENSUS",
            "CROSS_PROJECT_VERIFIED",
            "PROJECT_VERIFIED",
            "PROPOSED"
          ]
        },
        "refs": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}

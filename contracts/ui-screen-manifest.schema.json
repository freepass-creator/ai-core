{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/ui-screen-manifest.schema.json",
  "title": "AI Core Consumer Screen Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "screen_id",
    "product_profile",
    "feature_ids",
    "contracts",
    "verification"
  ],
  "properties": {
    "contract": {
      "const": "ai-core-ui-screen-manifest/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "screen_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "product_profile": {
      "type": "string",
      "minLength": 2
    },
    "feature_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_api",
        "workflow"
      ],
      "properties": {
        "data_api": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "pattern": "^C:"
          }
        },
        "workflow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "pattern": "^D:"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^uxe-[a-z0-9-]+$"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewports",
        "states",
        "input_modes",
        "locales"
      ],
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 240
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "input_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  }
}

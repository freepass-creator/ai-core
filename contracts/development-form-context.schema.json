{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development Form Runtime Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["laneAvailable", "implementationExists", "checksConfigured", "selectedPaths", "now", "trustedReviewReceipts", "trustedAuthorityAttestations"],
  "properties": {
    "laneAvailable": { "type": "boolean" },
    "implementationExists": { "type": "boolean" },
    "checksConfigured": { "type": "boolean" },
    "selectedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "now": { "type": "string", "format": "date-time" },
    "trustedReviewReceipts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "artifact_digest", "subject_revision", "reviewer", "issuer"], "properties": { "id": { "type": "string" }, "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "subject_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "reviewer": { "enum": ["CODEX", "CURSOR", "CLAUDE", "GEMINI", "HUMAN"] }, "issuer": { "type": "string" } } } },
    "trustedAuthorityAttestations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["authority_ref", "digest"], "properties": { "authority_ref": { "type": "string" }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/port/v1",
  "title": "AI Core Port Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "port_id",
    "port_version",
    "semantics",
    "direction",
    "input_schema",
    "output_schema",
    "side_effects",
    "idempotency",
    "error_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "core-port-contract/v1"
    },
    "port_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "port_version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "semantics": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "QUERY",
        "COMMAND",
        "READ",
        "WRITE",
        "SINK"
      ]
    },
    "input_schema": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "output_schema": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "side_effects": {
      "type": "boolean"
    },
    "idempotency": {
      "enum": [
        "REQUIRED",
        "SUPPORTED",
        "NOT_APPLICABLE"
      ]
    },
    "error_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/data-pipeline/v1",
  "title": "AI Core Import Export Pipeline Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_id",
    "direction",
    "version",
    "source",
    "target",
    "stages",
    "commit_policy",
    "receipt_required",
    "partial_failure_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "core-data-pipeline-contract/v1"
    },
    "pipeline_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "direction": {
      "enum": [
        "IMPORT",
        "EXPORT"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "RAW_SNAPSHOT",
          "PARSE",
          "NORMALIZE",
          "VALIDATE",
          "IDENTITY_RESOLVE",
          "MAP",
          "REVIEW",
          "COMMIT",
          "PROJECT",
          "PRIVACY_FILTER",
          "SERIALIZE",
          "DELIVER"
        ]
      },
      "uniqueItems": true
    },
    "commit_policy": {
      "enum": [
        "ATOMIC",
        "TRANSACTIONAL_BATCH",
        "BEST_EFFORT_BATCH",
        "APPEND_ONLY",
        "READ_ONLY"
      ]
    },
    "receipt_required": {
      "const": true
    },
    "partial_failure_policy": {
      "type": "string",
      "enum": [
        "NOT_APPLICABLE",
        "FAIL_BEFORE_COMMIT",
        "ROLLBACK_REQUIRED",
        "ALLOW_PARTIAL_WITH_RECEIPT"
      ],
      "description": "Declares what happens when a multi-item/batch write cannot complete as one atomic unit."
    }
  }
}

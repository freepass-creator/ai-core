{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://freepass.local/ai-core/stewardship-state.schema.json",
  "title":"Human Stewardship State",
  "type":"object",
  "required":["direction","reality","commitment","allowed_scope","done_when"],
  "properties":{
    "direction":{"type":"object","required":["goal","success"],"properties":{"goal":{"type":"string"},"success":{"type":"string"}}},
    "reality":{"type":"object","properties":{"source_revisions":{"type":"array"},"uncertainties":{"type":"array"}}},
    "foresight":{"type":"object","properties":{"failure_modes":{"type":"array"},"rollback":{"type":["string","null"]}}},
    "commitment":{"type":"object","properties":{"deadline":{"type":["string","null"]},"dependencies":{"type":"array"},"stakeholders":{"type":"array"}}},
    "resource_budget":{"type":"object"},
    "allowed_scope":{"type":"array"},
    "forbidden_scope":{"type":"array"},
    "done_when":{"type":"array","minItems":1},
    "evidence_required":{"type":"array"},
    "follow_up":{"type":"object"}
  },
  "additionalProperties":true
}

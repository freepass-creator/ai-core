{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.example/contracts/phase1-closeout.schema.json",
  "title": "AI Core Phase 1 Closeout Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "status", "observed_revision", "ci", "gates", "lanes", "deferrable"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "phase": { "const": "PHASE_1" },
    "status": { "enum": ["HOLD", "READY_FOR_BASELINE_LOCK", "BASELINE_LOCKED"] },
    "observed_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "head_sha", "conclusion"],
      "properties": {
        "run_id": { "type": ["integer", "null"], "minimum": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "conclusion": { "enum": ["success", "failure", "unknown"] }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownership_linked", "executable_baseline", "registry_linkage", "revision_evidence", "validation_green", "no_false_completion"],
      "properties": {
        "ownership_linked": { "type": "boolean" },
        "executable_baseline": { "type": "boolean" },
        "registry_linkage": { "type": "boolean" },
        "revision_evidence": { "type": "boolean" },
        "validation_green": { "type": "boolean" },
        "no_false_completion": { "type": "boolean" }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "status", "blockers", "evidence"],
        "properties": {
          "id": { "enum": ["A", "B", "C", "D"] },
          "owner": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "REVIEW", "HOLD"] },
          "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "revision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "deferrable": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

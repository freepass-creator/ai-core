{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.freepass.ai/governance/release-proof/v1",
  "title":"AI Core Release Proof v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","project_id","environment","expected_revision","build_status",
    "deployment","production_observation","runtime_smoke","rollback","result","observed_at"
  ],
  "properties":{
    "schema_version":{"const":"governance-release-proof/v1"},
    "project_id":{"type":"string","minLength":1},
    "environment":{"const":"PRODUCTION"},
    "expected_revision":{"type":"string","minLength":1},
    "build_status":{"enum":["PASS","FAIL","UNKNOWN"]},
    "deployment":{
      "type":"object",
      "additionalProperties":false,
      "required":["status","deployment_id","deployment_url"],
      "properties":{
        "status":{"enum":["READY","FAILED","UNKNOWN"]},
        "deployment_id":{"type":["string","null"]},
        "deployment_url":{"type":["string","null"]}
      }
    },
    "production_observation":{
      "type":"object",
      "additionalProperties":false,
      "required":["reachable","target_urls","observed_revision"],
      "properties":{
        "reachable":{"type":"boolean"},
        "target_urls":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "observed_revision":{"type":["string","null"]}
      }
    },
    "runtime_smoke":{
      "type":"object",
      "additionalProperties":false,
      "required":["status","evidence_refs"],
      "properties":{
        "status":{"enum":["PASS","FAIL","UNKNOWN"]},
        "evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "rollback":{
      "type":"object",
      "additionalProperties":false,
      "required":["available","plan_ref","previous_revision"],
      "properties":{
        "available":{"type":"boolean"},
        "plan_ref":{"type":["string","null"]},
        "previous_revision":{"type":["string","null"]}
      }
    },
    "result":{"enum":["VERIFIED","HOLD","FAILED"]},
    "observed_at":{"type":"string","format":"date-time"},
    "limitations":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/observability/context/v1",
  "title": "AI Core Observability Correlation Context v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","service_id","environment","service_version","correlation_id"],
  "properties":{
    "schema_version":{"const":"observability-context/v1"},
    "service_id":{"type":"string","minLength":1},
    "environment":{"type":"string","minLength":1},
    "service_version":{"type":"string","minLength":1},
    "request_id":{"type":["string","null"]},
    "correlation_id":{"type":"string","minLength":1},
    "causation_id":{"type":["string","null"]},
    "trace_id":{"type":["string","null"]},
    "span_id":{"type":["string","null"]},
    "job_id":{"type":["string","null"]},
    "actor_id":{"type":["string","null"]},
    "entity_type":{"type":["string","null"]},
    "entity_id":{"type":["string","null"]},
    "source_revision":{"type":["string","null"]}
  }
}

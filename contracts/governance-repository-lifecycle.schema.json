{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.freepass.ai/governance/repository-lifecycle/v1",
  "title":"AI Core Repository Lifecycle Record v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","repository","status","authority","reference_purpose",
    "retirement_gates","observed_at","evidence_refs"
  ],
  "properties":{
    "schema_version":{"const":"governance-repository-lifecycle/v1"},
    "repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "status":{"enum":["ACTIVE","REFERENCE","HOLD","RETIRE"]},
    "authority":{"type":["string","null"]},
    "reference_purpose":{"type":["string","null"]},
    "retirement_gates":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "observed_at":{"type":"string","format":"date-time"},
    "evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}

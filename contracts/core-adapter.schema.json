{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/adapter/v1",
  "title": "AI Core Adapter Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "port_id",
    "provider_scope",
    "project_scope",
    "source",
    "compatibility",
    "mapping",
    "side_effects",
    "idempotency",
    "retry_policy",
    "timeout_ms",
    "auth_boundary",
    "data_classification",
    "failure_mapping",
    "health_check",
    "verification_profile"
  ],
  "properties": {
    "schema_version": {
      "const": "core-adapter-contract/v1"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "port_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "provider_scope": {
      "type": "string",
      "minLength": 1
    },
    "project_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "revision"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port_versions",
        "engine_versions"
      ],
      "properties": {
        "port_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          }
        },
        "engine_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_field",
          "provider_field",
          "transformation"
        ],
        "properties": {
          "canonical_field": {
            "type": "string",
            "minLength": 1
          },
          "provider_field": {
            "type": "string",
            "minLength": 1
          },
          "transformation": {
            "type": "string",
            "minLength": 1
          },
          "unit_conversion": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "side_effects": {
      "type": "boolean"
    },
    "idempotency": {
      "enum": [
        "REQUIRED",
        "SUPPORTED",
        "NOT_APPLICABLE",
        "UNSUPPORTED"
      ]
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "backoff",
        "retryable_error_codes"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "backoff": {
          "enum": [
            "NONE",
            "FIXED",
            "EXPONENTIAL"
          ]
        },
        "retryable_error_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "auth_boundary": {
      "type": "string",
      "minLength": 1
    },
    "data_classification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PUBLIC",
          "INTERNAL",
          "CONFIDENTIAL",
          "PII",
          "FINANCIAL",
          "SECRET"
        ]
      }
    },
    "failure_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_code",
          "core_code"
        ],
        "properties": {
          "provider_code": {
            "type": "string",
            "minLength": 1
          },
          "core_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    },
    "health_check": {
      "type": "string",
      "minLength": 1
    },
    "verification_profile": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

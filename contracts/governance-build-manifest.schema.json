{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.freepass.ai/governance/build-manifest/v1",
  "title":"AI Core Build Manifest v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","project_id","source_revision","environment","runtime",
    "package_manager","install_command","build_command","lockfile",
    "checker_manifest_ref","artifact","build_provenance"
  ],
  "properties":{
    "schema_version":{"const":"governance-build-manifest/v1"},
    "project_id":{"type":"string","minLength":1},
    "source_revision":{"type":"string","minLength":1},
    "environment":{"enum":["CI","PREVIEW","PRODUCTION_BUILD"]},
    "runtime":{"type":"string","minLength":1},
    "package_manager":{"type":["string","null"]},
    "install_command":{"type":["string","null"]},
    "build_command":{"type":["string","null"]},
    "lockfile":{"type":["string","null"]},
    "checker_manifest_ref":{"type":["string","null"]},
    "artifact":{
      "type":"object",
      "additionalProperties":false,
      "required":["kind","artifact_id","digest"],
      "properties":{
        "kind":{"enum":["BUNDLE","CONTAINER","STATIC_SITE","PACKAGE","SCRIPT_SET","NONE"]},
        "artifact_id":{"type":["string","null"]},
        "digest":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"}
      }
    },
    "build_provenance":{
      "type":"object",
      "additionalProperties":false,
      "required":["builder_id","build_id","started_at","ended_at"],
      "properties":{
        "builder_id":{"type":"string","minLength":1},
        "build_id":{"type":"string","minLength":1},
        "started_at":{"type":"string","format":"date-time"},
        "ended_at":{"type":"string","format":"date-time"}
      }
    }
  }
}

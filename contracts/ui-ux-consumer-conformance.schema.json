{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/ui-ux-consumer-conformance.schema.json",
  "title": "AI Core UI UX Consumer Conformance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "definition_of_done",
    "consumers"
  ],
  "properties": {
    "contract": {
      "const": "ai-core-ui-ux-consumers/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "definition_of_done": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_conformant_consumers",
        "current_conformant_consumers",
        "status"
      ],
      "properties": {
        "required_conformant_consumers": {
          "type": "integer",
          "minimum": 2
        },
        "current_conformant_consumers": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "OPEN",
            "SATISFIED"
          ]
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "observed_revision",
          "relation",
          "adoption_status",
          "feature_refs",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "observed_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "relation": {
            "enum": [
              "EVIDENCE_SOURCE",
              "CANONICAL_CONSUMER"
            ]
          },
          "adoption_status": {
            "enum": [
              "EVIDENCE_ONLY",
              "MAPPED",
              "PILOT",
              "CONFORMANT"
            ]
          },
          "feature_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "conformance_revision": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{40}$"
          },
          "conformance_receipts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    }
  }
}

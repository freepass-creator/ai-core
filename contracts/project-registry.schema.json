{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Core Project Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "revision",
        "observed_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "GIT",
            "DOCUMENT",
            "DATABASE",
            "SERVICE",
            "DECISION"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "name",
        "organization",
        "repository_lifecycle_status",
        "execution_readiness_status",
        "mission",
        "repository",
        "default_branch",
        "local_path",
        "head_revision",
        "authoritative_sources",
        "commands",
        "deploy_targets",
        "required_approvals",
        "known_blockers"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "enum": [
            "HEADQUARTERS",
            "SUBSIDIARY"
          ]
        },
        "repository_lifecycle_status": {
          "enum": [
            "ACTIVE",
            "REFERENCE",
            "HOLD",
            "RETIRE"
          ],
          "description": "Repository authority/lifecycle classification. This does not grant execution authority."
        },
        "execution_readiness_status": {
          "enum": [
            "ACTIVE",
            "HOLD",
            "DISABLED"
          ],
          "description": "AI Core runtime readiness. Only ACTIVE may execute; HOLD/DISABLED fail closed."
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "system_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "access_entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_role", "clone_repository", "clone_command", "existing_checkout", "bootstrap_command", "data_runtime", "do_not_clone", "notes"],
          "properties": {
            "repository_role": { "type": "string", "minLength": 1 },
            "clone_repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "clone_command": { "type": "string", "minLength": 1 },
            "existing_checkout": { "type": "string", "minLength": 1 },
            "bootstrap_command": { "type": "string", "minLength": 1 },
            "data_runtime": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "project_id", "repository"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "project_id": { "type": "string", "minLength": 1 },
                "repository": { "const": false }
              }
            },
            "do_not_clone": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
            },
            "notes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "work_branches": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "local_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "authoritative_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "install",
            "test",
            "build"
          ],
          "properties": {
            "install": {
              "type": [
                "string",
                "null"
              ]
            },
            "test": {
              "type": [
                "string",
                "null"
              ]
            },
            "build": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "commands_absent_reason": {
          "type": "object",
          "additionalProperties": false,
          "description": "Why a command is absent. An ACTIVE project whose test or build command is null must record one here: a step that genuinely does not exist has to stay distinguishable from one that simply has not been established yet.",
          "properties": {
            "install": {
              "type": "string",
              "minLength": 10
            },
            "test": {
              "type": "string",
              "minLength": 10
            },
            "build": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        "deploy_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_approvals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "known_blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/ai-core/task.schema.json",
  "title": "AI Core Task Envelope",
  "type": "object",
  "required": ["goal", "external_effect"],
  "properties": {
    "task_id": { "type": "string" },
    "goal": { "type": "string", "minLength": 1 },
    "desired_outcome": { "type": ["string", "null"] },
    "outcome_observation": {
      "type": ["object", "null"],
      "required": ["event_or_metric", "evidence_required"],
      "properties": {
        "event_or_metric": { "type": "string", "minLength": 1 },
        "evidence_required": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "project": { "type": ["string", "null"] },
    "project_ref": { "type": "string", "minLength": 1, "default": "main" },
    "domain": { "enum": ["development", "document", "legal", "business", "communication"] },
    "applicable_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["development", "document", "legal", "business", "communication"]
      }
    },
    "risk": { "enum": ["A", "B", "C", "D"] },
    "authority_required": { "type": "boolean" },
    "done_when": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["text"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["automated", "manual", "external"] },
              "required": { "type": "boolean", "default": true }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "allowed_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "related_commitment_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "resource_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "portfolio_effect": {
      "enum": [
        "none", "create_commitment", "change_commitment", "change_deadline",
        "change_priority", "change_allocation", "unknown"
      ]
    },
    "recovery_strategy": { "type": ["string", "null"], "minLength": 1 },
    "changed_files_estimate": { "type": "integer", "minimum": 0 },
    "needs_build": { "type": "boolean" },
    "needs_dependency_install": { "type": "boolean" },
    "needs_runtime_debug": { "type": "boolean" },
    "cloud_reproducible": { "type": "boolean" },
    "external_effect": { "type": "string", "minLength": 1 },
    "intent_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement"],
        "properties": {
          "id": { "type": "string" },
          "field": { "type": "string" },
          "statement": { "type": "string", "minLength": 1 },
          "confirmation_prompt": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "changes_decision": { "type": "boolean" },
          "confirmed": { "type": "boolean" },
          "confirmation": {
            "type": ["object", "null"],
            "properties": {
              "authority": { "const": "user_directive" },
              "source_ref": {
                "type": "object",
                "required": ["location"],
                "properties": {
                  "location": { "type": "string", "minLength": 1 },
                  "revision_or_sha": { "type": "string" },
                  "observed_at": { "type": "string", "format": "date-time" }
                },
                "anyOf": [
                  { "required": ["revision_or_sha"] },
                  { "required": ["observed_at"] }
                ],
                "additionalProperties": false
              }
            },
            "required": ["authority", "source_ref"],
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "confirmed": { "const": true } },
              "required": ["confirmed"]
            },
            "then": { "required": ["confirmation"] }
          },
          {
            "if": {
              "properties": { "confirmed": { "const": false } },
              "required": ["confirmed"]
            },
            "then": { "not": { "required": ["confirmation"] } }
          }
        ],
        "additionalProperties": false
      }
    },
    "decision_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prompt"],
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 },
          "decision_impact": { "type": "number", "minimum": 0, "maximum": 5 },
          "irreversibility": { "type": "number", "minimum": 0, "maximum": 5 },
          "uncertainty": { "type": "number", "minimum": 0, "maximum": 5 },
          "user_effort": { "type": "number", "minimum": 1 },
          "already_known": { "type": "boolean" },
          "externally_resolvable": { "type": "boolean" },
          "changes_decision": { "type": "boolean" },
          "user_judgment_required": { "type": "boolean" },
          "resolution_ref": {
            "type": "object",
            "required": ["location"],
            "properties": {
              "location": { "type": "string", "minLength": 1 },
              "revision_or_sha": { "type": "string", "minLength": 1 },
              "observed_at": { "type": "string", "format": "date-time" }
            },
            "anyOf": [
              { "required": ["revision_or_sha"] },
              { "required": ["observed_at"] }
            ],
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "already_known": { "const": true } },
              "required": ["already_known"]
            },
            "then": { "required": ["resolution_ref"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "proposed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "effect", "reversible"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 },
          "reversible": { "type": "boolean" },
          "approval_required": { "type": "boolean" },
          "depends_on": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/governance/activation-decision/v1",
  "title": "AI Core Activation Decision v1",
  "description": "Separates complete observation from authority to promote or activate a canonical release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "observation",
    "review",
    "release",
    "decision",
    "reasons",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "governance-activation-decision/v1"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "revision"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {"enum": ["APPROVED", "HOLD", "UNKNOWN"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "release_id", "evidence_refs"],
      "properties": {
        "status": {"enum": ["BUILT", "NOT_BUILT", "UNKNOWN"]},
        "release_id": {"type": ["string", "null"], "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision": {
      "enum": ["AUTHORIZED", "HOLD"]
    },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"const": "AUTHORIZED"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "observation": {
            "properties": {"status": {"const": "COMPLETE"}},
            "required": ["status"]
          },
          "review": {
            "properties": {"status": {"const": "APPROVED"}},
            "required": ["status"]
          },
          "release": {
            "properties": {
              "status": {"const": "BUILT"},
              "release_id": {"type": "string", "minLength": 1}
            },
            "required": ["status", "release_id"]
          },
          "reasons": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"decision": {"const": "HOLD"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "reasons": {"minItems": 1}
        }
      }
    }
  ]
}
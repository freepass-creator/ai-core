{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Core Work Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "work_types",
    "hub_routes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "hub_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "no_match", "tie", "rules"],
      "properties": {
        "version": { "const": 1 },
        "no_match": { "const": "HOLD" },
        "tie": { "const": "HOLD" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "priority", "primary", "secondary", "match_any"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
              "priority": { "type": "integer", "minimum": 0 },
              "primary": {
                "enum": ["design", "data", "document", "engineering", "integration", "quality", "delivery", "control-plane"]
              },
              "secondary": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": ["design", "data", "document", "engineering", "integration", "quality", "delivery"]
                }
              },
              "match_any": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "work_types": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "work_type_id",
          "name",
          "domain",
          "aliases",
          "target_project_id",
          "capability_id",
          "approval_boundary",
          "completion_condition",
          "source_pointers"
        ],
        "properties": {
          "work_type_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "development",
              "design",
              "sales",
              "operations",
              "finance",
              "document",
              "business",
              "legal",
              "website",
              "settlement"
            ]
          },
          "aliases": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_project_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$"
          },
          "approval_boundary": {
            "enum": [
              "NONE",
              "READ_ONLY",
              "PROJECT_RULES",
              "MERGE_APPROVAL",
              "USER_APPROVAL_FOR_EXTERNAL_WRITE"
            ]
          },
          "completion_condition": {
            "type": "string",
            "minLength": 1
          },
          "source_pointers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{2,80}$"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/request-context/v1",
  "title": "AI Core Request Context and Idempotency v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "correlation_id",
    "actor",
    "expected_revision",
    "idempotency"
  ],
  "properties": {
    "schema_version": {
      "const": "core-request-context/v1"
    },
    "request_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
    },
    "correlation_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/correlation_id"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_type": {
          "enum": [
            "USER",
            "SERVICE",
            "SYSTEM",
            "AUTOMATION"
          ]
        }
      }
    },
    "expected_revision": {
      "anyOf": [
        {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotency": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "NOT_APPLICABLE"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "key",
            "semantic_payload_digest"
          ],
          "properties": {
            "mode": {
              "const": "REQUIRED"
            },
            "key": {
              "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
            },
            "semantic_payload_digest": {
              "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/checksum"
            }
          }
        }
      ]
    },
    "execution": {
      "$ref": "https://schemas.freepass.ai/core/execution-identity/v1#/$defs/binding"
    }
  }
}

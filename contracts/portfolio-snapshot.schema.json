{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/ai-core/portfolio-snapshot.schema.json",
  "title": "Scoped AIOPS Portfolio Snapshot",
  "type": "object",
  "required": ["revision", "observed_at", "commitments"],
  "properties": {
    "revision": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "commitments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "commitment_id", "goal_summary", "status", "dependencies",
          "resource_claims", "priority", "source_ref", "sanitized"
        ],
        "properties": {
          "commitment_id": { "type": "string", "minLength": 1 },
          "goal_summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "status": { "enum": ["PLANNED", "ACTIVE", "BLOCKED", "COMPLETED", "CANCELLED"] },
          "due_at": { "type": ["string", "null"], "format": "date-time" },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "resource_claims": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "priority": {
            "enum": [
              "USER_CONFIRMED_HIGH", "USER_CONFIRMED_MEDIUM",
              "USER_CONFIRMED_LOW", "UNKNOWN"
            ]
          },
          "source_ref": {
            "type": "object",
            "required": ["location", "revision_or_sha"],
            "properties": {
              "location": { "type": "string", "minLength": 1 },
              "revision_or_sha": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "sanitized": { "const": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/release/manifest-registry/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": { "const": "release-manifest-registry/v1" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "repository", "default_branch", "platform", "pull_request", "production", "rollback"],
        "properties": {
          "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "default_branch": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["NONE", "VERCEL", "FIREBASE_HOSTING", "CUSTOM"] },
          "pull_request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ci_commands", "preview"],
            "properties": {
              "ci_commands": { "$ref": "#/$defs/commands" },
              "preview": {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "reason"],
                "properties": {
                  "mode": { "enum": ["PLATFORM_GIT_INTEGRATION", "COMMAND", "CI_ONLY", "NONE"] },
                  "command": { "$ref": "#/$defs/command" },
                  "reason": { "type": ["string", "null"] }
                }
              }
            }
          },
          "production": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "reason", "deploy_command", "required_env", "revision_probe", "smoke_urls", "max_run_attempt"],
            "properties": {
              "enabled": { "type": "boolean" },
              "reason": { "type": ["string", "null"] },
              "deploy_command": { "anyOf": [{ "$ref": "#/$defs/command" }, { "type": "null" }] },
              "required_env": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
              "revision_probe": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url", "format", "field"],
                    "properties": {
                      "url": { "type": "string", "format": "uri", "pattern": "^https://" },
                      "format": { "enum": ["TEXT", "JSON"] },
                      "field": { "type": ["string", "null"] }
                    }
                  }
                ]
              },
              "smoke_urls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
              "max_run_attempt": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          },
          "rollback": {
            "type": "object",
            "additionalProperties": false,
            "required": ["available", "plan_ref"],
            "properties": {
              "available": { "type": "boolean" },
              "plan_ref": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adapter Contract",
  "type": "object",
  "required": ["adapter_id", "port_id", "provider_scope", "source", "compatibility", "mapping", "side_effects", "idempotency", "retry_policy", "timeout_ms", "auth_boundary", "data_classification", "failure_mapping", "health_check", "verification_profile"],
  "properties": {
    "adapter_id": {"type": "string", "minLength": 3},
    "port_id": {"type": "string", "minLength": 3},
    "provider_scope": {"type": "string", "minLength": 1},
    "project_scope": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "required": ["locator", "revision"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "required": ["port_versions"],
      "properties": {
        "port_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "engine_versions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "mapping": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "side_effects": {"type": "boolean"},
    "idempotency": {"type": "string", "enum": ["REQUIRED", "SUPPORTED", "NOT_APPLICABLE", "UNSUPPORTED"]},
    "retry_policy": {"type": "string", "minLength": 1},
    "timeout_ms": {"type": "integer", "minimum": 1},
    "auth_boundary": {"type": "string", "minLength": 1},
    "data_classification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failure_mapping": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "health_check": {"type": "string", "minLength": 1},
    "verification_profile": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
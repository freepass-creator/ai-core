{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-core.local/contracts/change-packet.schema.json",
  "title": "Change Packet",
  "type": "object",
  "required": ["task_id", "project_id", "source_revision", "user_intent", "desired_outcome", "acceptance_criteria", "non_goals", "verification_obligations", "authorization"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "user_intent": {"type": "string", "minLength": 1},
    "desired_outcome": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "affected_surfaces": {"type": "array", "items": {"type": "string"}},
    "reuse_candidates": {"type": "array", "items": {"type": "string"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "verification_obligations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preview_obligations": {"type": "array", "items": {"type": "string"}},
    "rollback_condition": {"type": ["string", "null"]},
    "authorization": {
      "type": "object",
      "required": ["execution_authorized"],
      "properties": {
        "execution_authorized": {"type": "boolean"},
        "external_actions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

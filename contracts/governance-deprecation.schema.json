{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.freepass.ai/governance/deprecation/v1",
  "title":"AI Core Deprecation and Removal Record v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","item_id","item_kind","state","replacement","deprecated_since",
    "target_removal","affected_consumers","migration_guide_ref","evidence_refs"
  ],
  "properties":{
    "schema_version":{"const":"governance-deprecation/v1"},
    "item_id":{"type":"string","minLength":1},
    "item_kind":{"enum":["REPOSITORY","CAPABILITY","API","CONTRACT","ADAPTER","DATA_SOURCE"]},
    "state":{"enum":["ACTIVE","DEPRECATED","READ_ONLY","RETIRED","REMOVED"]},
    "replacement":{"type":["string","null"]},
    "deprecated_since":{"type":["string","null"]},
    "target_removal":{
      "type":"object",
      "additionalProperties":false,
      "required":["version","date"],
      "properties":{
        "version":{"type":["string","null"]},
        "date":{"type":["string","null"],"format":"date"}
      }
    },
    "affected_consumers":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "migration_guide_ref":{"type":["string","null"]},
    "evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}

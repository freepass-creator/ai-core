{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/event-type/v1",
  "title": "AI Core Event Type Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_version",
    "producer",
    "payload_schema",
    "consumers",
    "duplicate_policy",
    "replay_policy",
    "retention"
  ],
  "properties": {
    "schema_version": {
      "const": "core-event-type-contract/v1"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*){2,}$"
    },
    "event_version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "payload_schema": {
      "type": "string",
      "minLength": 1
    },
    "consumers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duplicate_policy": {
      "enum": [
        "IDEMPOTENT_BY_EVENT_ID",
        "REJECT_DUPLICATE",
        "CONSUMER_DEFINED"
      ]
    },
    "replay_policy": {
      "enum": [
        "REPLAYABLE",
        "NOT_REPLAYABLE",
        "REPLAY_REQUIRES_APPROVAL"
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_days"
      ],
      "properties": {
        "minimum_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

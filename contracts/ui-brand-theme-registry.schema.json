{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/ui-brand-theme-registry.schema.json",
  "title": "AI Core UI Brand Theme Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "theme_modes",
    "invariant_roles",
    "themes"
  ],
  "properties": {
    "contract": {
      "const": "ai-core-ui-brand-themes/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "theme_modes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "freepass",
          "cobrand",
          "white-label"
        ]
      }
    },
    "invariant_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "colors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "mode": {
            "enum": [
              "freepass",
              "cobrand",
              "white-label"
            ]
          },
          "colors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "primary",
              "strong",
              "soft"
            ],
            "properties": {
              "primary": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "strong": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "soft": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "strongest": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "soft_border": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "partner_accent": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/observability/health/v1",
  "title": "AI Core Observability Health v1",
  "type": "object",
  "additionalProperties": false,
  "required":["schema_version","service_id","environment","checked_at","subject_revision","status","checks"],
  "properties":{
    "schema_version":{"const":"observability-health/v1"},
    "service_id":{"type":"string","minLength":1},
    "environment":{"type":"string","minLength":1},
    "checked_at":{"type":"string","format":"date-time"},
    "subject_revision":{"type":"string","minLength":1},
    "status":{"enum":["OK","DEGRADED","FAIL","UNKNOWN"]},
    "checks":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["name","kind","status","observed_at","stale_after_seconds","detail"],
        "properties":{
          "name":{"type":"string","minLength":1},
          "kind":{"enum":["LIVENESS","READINESS","DEPENDENCY","FRESHNESS","SCHEDULER","TERMINAL_EVIDENCE"]},
          "status":{"enum":["OK","DEGRADED","FAIL","UNKNOWN"]},
          "observed_at":{"type":["string","null"],"format":"date-time"},
          "stale_after_seconds":{"type":["integer","null"],"minimum":0},
          "source_revision":{"type":["string","null"]},
          "detail":{"type":"string","minLength":1},
          "evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      }
    }
  }
}

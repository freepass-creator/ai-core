{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/ai-core/proof-receipt.schema.json",
  "title": "AI Core Proof Receipt",
  "type": "object",
  "required": [
    "receipt_id",
    "obligation_id",
    "task_id",
    "subject_revision",
    "requirement_set_digest",
    "policy_revision",
    "result",
    "executed_checks",
    "verifier",
    "verified_at",
    "artifact_ref",
    "execution_ref",
    "evidence_refs"
  ],
  "properties": {
    "receipt_id": { "type": "string", "minLength": 1 },
    "obligation_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "project": { "type": ["string", "null"] },
    "subject_revision": { "type": "string", "minLength": 1 },
    "requirement_set_digest": { "type": "string", "pattern": "^sha256:" },
    "policy_revision": { "type": "string", "minLength": 1 },
    "result": { "enum": ["PASS", "FAIL", "PARTIAL", "SKIPPED", "UNKNOWN"] },
    "executed_checks": { "type": "integer", "minimum": 0 },
    "verifier": { "type": "string", "minLength": 1 },
    "verified_at": { "type": "string", "format": "date-time" },
    "artifact_ref": { "$ref": "#/$defs/evidencePointer" },
    "execution_ref": { "$ref": "#/$defs/evidencePointer" },
    "requirement_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "requirement_fingerprint",
          "mode",
          "result",
          "verifier",
          "verified_at",
          "evidence_refs"
        ],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "requirement_fingerprint": { "type": "string", "pattern": "^sha256:" },
          "mode": { "enum": ["automated", "manual", "external"] },
          "result": { "enum": ["PASS", "FAIL", "NOT_RUN", "UNKNOWN", "CONFIRMED", "EVIDENCED"] },
          "executed_checks": { "type": "integer", "minimum": 0 },
          "verifier": { "type": "string", "minLength": 1 },
          "verified_at": { "type": "string", "format": "date-time" },
          "evidence_refs": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidencePointer" }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencePointer" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidencePointer": {
      "type": "object",
      "required": ["location"],
      "properties": {
        "location": { "type": "string", "minLength": 1 },
        "revision_or_sha": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" }
      },
      "anyOf": [
        { "required": ["revision_or_sha"] },
        { "required": ["observed_at"] }
      ],
      "additionalProperties": false
    }
  }
}

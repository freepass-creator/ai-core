{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/contract-adoption/v1",
  "title": "AI Core Contract Adoption Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "core-contract-adoption-registry/v1"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "classification",
        "binding_state",
        "priority",
        "evidence_refs",
        "action"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "CORE_MATCH",
            "ADAPTER_ONLY",
            "MIGRATE",
            "D_OWNED_WORKFLOW",
            "B_OWNED_PRESENTATION",
            "LEGACY_RETIRED",
            "NOT_APPLICABLE"
          ]
        },
        "binding_state": {
          "enum": [
            "NONE",
            "SHADOW",
            "VALIDATED",
            "CUTOVER_READ",
            "CUTOVER_WRITE",
            "RETIRED"
          ]
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "NA"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository",
        "source_ref",
        "subject_revision",
        "phase",
        "assessments",
        "next_gate"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "subject_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "phase": {
          "enum": [
            "INVENTORY",
            "SHADOW",
            "VALIDATED",
            "CUTOVER_READ",
            "CUTOVER_WRITE",
            "RETIRED"
          ]
        },
        "assessments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessment"
          }
        },
        "next_gate": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

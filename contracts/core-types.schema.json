{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/types/v1",
  "title": "AI Core Common Value Types v1",
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*/v[1-9][0-9]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "datetime": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_minor",
        "currency"
      ],
      "properties": {
        "amount_minor": {
          "type": "integer"
        },
        "currency": {
          "$ref": "#/$defs/currency"
        }
      }
    },
    "percentage": {
      "type": "number",
      "description": "Canonical percentage points. 10 means 10%, never 0.10. Provider ratios are adapter concerns."
    },
    "correlation_id": {
      "$ref": "#/$defs/stable_id"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

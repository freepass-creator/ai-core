{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Core Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "capabilities"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "observed_at": { "type": "string", "format": "date-time" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{1,63}$" },
        "required": { "type": "boolean" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any", "min_score"],
      "properties": {
        "any": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "all": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "none": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "min_score": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "adapter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "BUILTIN" },
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command_key"],
          "properties": {
            "kind": { "const": "PROJECT_REGISTRY_COMMAND" },
            "command_key": { "enum": ["install", "test", "build"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "argv"],
          "properties": {
            "kind": { "const": "PROJECT_COMMAND" },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "receipt": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "directory", "prefix", "suffix", "schema_field", "schema_value", "state_field", "success_states", "hold_states", "failure_states"],
              "properties": {
                "kind": { "const": "NEW_JSON_TERMINAL_RECEIPT" },
                "directory": { "type": "string", "minLength": 1 },
                "prefix": { "type": "string", "minLength": 1 },
                "suffix": { "type": "string", "minLength": 1 },
                "schema_field": { "type": "string", "minLength": 1 },
                "schema_value": { "type": "string", "minLength": 1 },
                "state_field": { "type": "string", "minLength": 1 },
                "success_states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "hold_states": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "failure_states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entrypoint", "export"],
          "properties": {
            "kind": { "const": "PROJECT_MODULE" },
            "entrypoint": { "type": "string", "minLength": 1 },
            "export": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" }
          }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "status", "domains", "projects", "mode", "priority",
        "match", "adapter", "inputs", "required_scopes", "walls", "result_contract"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,80}$" },
        "title": { "type": "string", "minLength": 2 },
        "status": { "enum": ["ACTIVE", "HOLD", "REFERENCE"] },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["general", "development", "operations", "finance", "sales", "document", "analysis"] }
        },
        "projects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(\\*|[a-z][a-z0-9-]{1,62})$" }
        },
        "mode": { "enum": ["READ_ONLY", "LOCAL_MUTATION", "EXTERNAL_MUTATION"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "match": { "$ref": "#/$defs/match" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
        "required_scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "walls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "result_contract": { "const": "ai-core-work-result/v1" }
      }
    }
  }
}

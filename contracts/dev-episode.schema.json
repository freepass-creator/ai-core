{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-core.local/contracts/dev-episode.schema.json",
  "title": "Development Episode",
  "type": "object",
  "required": ["episode_id", "project_id", "state", "requirement_set_digest", "source_revision"],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "state": {
      "enum": ["DISCOVERING","FRAMED","READY","IMPLEMENTING","VERIFYING","PREVIEW_READY","USER_REVIEW","RELEASE_READY","RELEASED","OBSERVING","CLOSED","BLOCKED","STALE","ABORTED"]
    },
    "requirement_set_digest": {"type": "string", "minLength": 8},
    "source_revision": {"type": "string", "minLength": 1},
    "active_requirement_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "owner": {"type": ["string", "null"]},
    "write_scope": {"type": "array", "items": {"type": "string"}, "default": []},
    "blockers": {"type": "array", "items": {"type": "string"}, "default": []},
    "unknowns": {"type": "array", "items": {"type": "string"}, "default": []},
    "proof_refs": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/security/audit-record/v1",
  "title": "AI Core Security Audit Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "occurred_at",
    "actor_id",
    "action",
    "resource",
    "result",
    "correlation_id",
    "subject_revision",
    "changed_fields",
    "redaction_profile",
    "sensitive_values_embedded",
    "evidence_refs",
    "audit_criticality",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "security-audit-record/v1"},
    "audit_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": ["string", "null"]}
      }
    },
    "result": {"enum": ["ALLOWED", "DENIED", "SUCCEEDED", "FAILED", "HOLD"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "subject_revision": {"type": ["string", "null"]},
    "changed_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "redaction_profile": {"type": "string", "minLength": 1},
    "sensitive_values_embedded": {"const": false},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "audit_criticality": {"enum": ["TELEMETRY_BEST_EFFORT", "REQUIRED_AUDIT", "EVIDENTIARY"]},
    "integrity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["previous_digest", "record_digest"],
      "properties": {
        "previous_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/workflow-bridge.schema.json",
  "title": "AI Core Workflow Bridge Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "bridges"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "bridges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bridge_id", "adoption_status", "relation", "source", "target",
          "dispatch", "authority", "idempotency", "direct_transition_allowed",
          "description"
        ],
        "properties": {
          "bridge_id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
          "adoption_status": { "enum": ["CANONICAL", "SHADOW", "PILOT", "DEPRECATED"] },
          "relation": {
            "enum": [
              "COMMAND_TRIGGER",
              "INVALIDATION_TRIGGER",
              "EVIDENCE_FEED",
              "PROJECTION_DEPENDENCY"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["WORKFLOW_EVENT", "DOMAIN_EVENT", "STATE_PROJECTION"] },
              "workflow_id": { "type": "string" },
              "event_type": { "type": "string" },
              "raw_event_type": { "type": "string" },
              "projection_ref": { "type": "string" }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["WORKFLOW_COMMAND", "WORKFLOW_EVIDENCE", "DERIVED_PROJECTION"] },
              "workflow_id": { "type": "string" },
              "command_id": { "type": "string" },
              "projection_ref": { "type": "string" }
            }
          },
          "dispatch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "cardinality"],
            "properties": {
              "mode": { "enum": ["NONE", "SAME_TRANSACTION", "OUTBOX", "MANUAL"] },
              "cardinality": { "enum": ["ONE", "ALL_CHILDREN", "MATCHING_CHILDREN"] }
            }
          },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "source"],
            "properties": {
              "required": { "type": "boolean" },
              "source": { "type": ["string", "null"] }
            }
          },
          "idempotency": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope"],
            "properties": {
              "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
            }
          },
          "direct_transition_allowed": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "source_authority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "revision", "files"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "blob_sha"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

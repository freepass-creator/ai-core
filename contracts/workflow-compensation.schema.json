{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/workflow-compensation.schema.json",
  "title": "AI Core Workflow Compensation Policy Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "policies"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_id",
          "adoption_status",
          "evidence_level",
          "source_projects",
          "execution_mode",
          "compensation_order",
          "effect_contract",
          "failure_outcome",
          "source_authority"
        ],
        "properties": {
          "policy_id": {
            "type": "string",
            "pattern": "^workflow\\.[a-z0-9][a-z0-9.-]*$"
          },
          "adoption_status": {
            "enum": [
              "PILOT",
              "COMMON_ADOPTED",
              "DEPRECATED"
            ]
          },
          "evidence_level": {
            "enum": [
              "PROJECT_VERIFIED",
              "CROSS_PROJECT_VERIFIED",
              "COMMON_ADOPTED"
            ]
          },
          "source_projects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "execution_mode": {
            "const": "SEQUENTIAL_EFFECTS"
          },
          "compensation_order": {
            "const": "REVERSE_APPLIED_ONLY"
          },
          "effect_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "compensation_declaration",
              "non_compensated_reason_required",
              "audit_required"
            ],
            "properties": {
              "compensation_declaration": {
                "const": "PER_EFFECT"
              },
              "non_compensated_reason_required": {
                "const": true
              },
              "audit_required": {
                "const": true
              }
            }
          },
          "failure_outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "original_failure",
              "compensation_success",
              "compensation_failure"
            ],
            "properties": {
              "original_failure": {
                "const": "PRESERVE"
              },
              "compensation_success": {
                "const": "RETHROW_ORIGINAL_FAILURE"
              },
              "compensation_failure": {
                "const": "PARTIAL_STATE_ESCALATION"
              }
            }
          },
          "notes": {
            "type": "string"
          },
          "source_authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "revision",
              "files"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "blob_sha"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "blob_sha": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

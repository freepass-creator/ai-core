{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/ui-ux-consumer-manifest.schema.json",
  "title": "AI Core UI/UX Consumer Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "product",
    "ai_core",
    "adoption_status",
    "local_authorities",
    "required_feature_ids",
    "feature_bindings",
    "verification",
    "exceptions",
    "conformance_receipts"
  ],
  "properties": {
    "contract": {
      "const": "ai-core-ui-ux-consumer/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "profile",
        "mapping_base_revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "profile": {
          "type": "string",
          "minLength": 2
        },
        "mapping_base_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "ai_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "feature_registry_version",
        "status"
      ],
      "properties": {
        "repository": {
          "const": "freepass-creator/ai-core"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "feature_registry_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "status": {
          "enum": [
            "CANDIDATE_PR",
            "CANONICAL"
          ]
        },
        "pull_request": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "CANDIDATE_PR"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "pull_request"
            ],
            "properties": {
              "pull_request": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "adoption_status": {
      "enum": [
        "MAPPED",
        "PILOT",
        "CONFORMANT"
      ]
    },
    "local_authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "required_feature_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "feature_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "implementation",
          "local_evidence"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "implementation": {
            "enum": [
              "NATIVE_PRODUCT",
              "AI_CORE_RUNTIME",
              "COMPATIBILITY_BINDING"
            ]
          },
          "local_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "viewports",
        "input_modes",
        "locales",
        "pending_conformance"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 240
          }
        },
        "input_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "pending_conformance": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "reason",
          "owner",
          "review_on"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 2
          },
          "reason": {
            "type": "string",
            "minLength": 5
          },
          "owner": {
            "type": "string",
            "minLength": 2
          },
          "review_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "conformance_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adoption_status": {
            "const": "CONFORMANT"
          }
        },
        "required": [
          "adoption_status"
        ]
      },
      "then": {
        "properties": {
          "ai_core": {
            "properties": {
              "status": {
                "const": "CANONICAL"
              }
            },
            "type": "object",
            "required": [
              "status"
            ],
            "additionalProperties": true
          },
          "conformance_receipts": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}

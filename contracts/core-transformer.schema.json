{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/transformer/v1",
  "title": "AI Core Parser Normalizer Mapper Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transformer_id",
    "kind",
    "version",
    "source",
    "input_contract",
    "output_contract",
    "deterministic",
    "issue_codes",
    "verification_profile"
  ],
  "properties": {
    "schema_version": {
      "const": "core-transformer-contract/v1"
    },
    "transformer_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "kind": {
      "enum": [
        "PARSER",
        "NORMALIZER",
        "MAPPER"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "revision"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
        }
      }
    },
    "input_contract": {
      "type": "string",
      "minLength": 1
    },
    "output_contract": {
      "type": "string",
      "minLength": 1
    },
    "deterministic": {
      "type": "boolean"
    },
    "issue_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "verification_profile": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

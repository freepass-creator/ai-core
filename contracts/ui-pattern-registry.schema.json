{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/ui-pattern-registry.schema.json",
  "title": "AI Core UI Pattern Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "feature_registry",
    "component_registry",
    "patterns"
  ],
  "properties": {
    "contract": {
      "const": "ai-core-ui-pattern-registry/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "feature_registry": {
      "const": "registry/ui-ux-features.json"
    },
    "component_registry": {
      "const": "design-system/components.registry.json"
    },
    "patterns": {
      "type": "array",
      "minItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "layer",
          "implementation_status",
          "component_feature_refs",
          "contract_source"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 2
          },
          "layer": {
            "enum": [
              "pattern",
              "workflow",
              "surface"
            ]
          },
          "implementation_status": {
            "enum": [
              "BASE_COMPAT",
              "RUNTIME_V2",
              "CONTRACT_ONLY"
            ]
          },
          "component_feature_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "css_selector": {
            "type": "string",
            "minLength": 2
          },
          "contract_source": {
            "type": "string",
            "minLength": 2
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/workflow.schema.json",
  "title": "AI Core Workflow Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "primitives",
    "workflows"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "primitives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/primitive"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow"
      }
    }
  },
  "$defs": {
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primitive_id",
        "status",
        "meaning",
        "evidence_level"
      ],
      "properties": {
        "primitive_id": {
          "type": "string",
          "pattern": "^workflow\\.[a-z0-9][a-z0-9.-]*$"
        },
        "status": {
          "enum": [
            "COMMON_ADOPTED",
            "PILOT",
            "PROPOSED"
          ]
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "evidence_level": {
          "enum": [
            "PROPOSED",
            "PROJECT_VERIFIED",
            "CROSS_PROJECT_VERIFIED",
            "COMMON_ADOPTED"
          ]
        },
        "source_projects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "version",
        "adoption_status",
        "owner",
        "state_axes",
        "facts",
        "guards",
        "evidence_requirements",
        "commands",
        "events",
        "transitions",
        "obligations"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "adoption_status": {
          "enum": [
            "CANONICAL",
            "SHADOW",
            "PILOT",
            "DEPRECATED"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "state_axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stateAxis"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guard"
          }
        },
        "evidence_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRequirement"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "source_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision",
            "files"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "blob_sha"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "blob_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "stateAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis_id",
        "initial_state",
        "states"
      ],
      "properties": {
        "axis_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "initial_state": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "kind",
        "terminal"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "kind": {
          "enum": [
            "NORMAL",
            "HOLD",
            "FINAL",
            "FAILURE",
            "CANCELLED"
          ]
        },
        "terminal": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "type"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "type": {
          "enum": [
            "boolean",
            "string",
            "number",
            "integer",
            "object",
            "array"
          ]
        },
        "description": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guard_id",
        "kind"
      ],
      "properties": {
        "guard_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "kind": {
          "enum": [
            "FACT_PRESENT",
            "FACT_EQUALS",
            "CUSTOM"
          ]
        },
        "fact_id": {
          "type": "string"
        },
        "expected": {},
        "description": {
          "type": "string"
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "verification"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "verification": {
          "enum": [
            "HUMAN_REPORTED",
            "SYSTEM_VERIFIED",
            "EXTERNAL_AUTHORITY"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "intent",
        "idempotency_required"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_required": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "meaning"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9_-]*){2,}$"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "required_roles",
        "separation_of_duties"
      ],
      "properties": {
        "policy": {
          "enum": [
            "NONE",
            "ANY_ONE",
            "ALL"
          ]
        },
        "required_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "separation_of_duties": {
          "type": "boolean"
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "max_attempts",
        "base_delay_ms",
        "retryable_error_codes"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "NONE",
            "FIXED",
            "EXPONENTIAL",
            "MANUAL"
          ]
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "base_delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "retryable_error_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_exhausted"
      ],
      "properties": {
        "on_exhausted": {
          "enum": [
            "FAIL",
            "HOLD",
            "COMPENSATE",
            "ESCALATE"
          ]
        },
        "failure_state": {
          "type": "string"
        },
        "compensation_transition_id": {
          "type": "string"
        },
        "escalation_event_type": {
          "type": "string"
        }
      }
    },
    "timeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_ms",
        "action"
      ],
      "properties": {
        "after_ms": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "HOLD",
            "FAIL",
            "ESCALATE",
            "TRANSITION"
          ]
        },
        "transition_id": {
          "type": "string"
        }
      }
    },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "due_within_ms",
        "breach_event_type"
      ],
      "properties": {
        "due_within_ms": {
          "type": "integer",
          "minimum": 1
        },
        "breach_event_type": {
          "type": "string",
          "minLength": 1
        },
        "escalation_transition_id": {
          "type": "string"
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "trigger_event_types"
      ],
      "properties": {
        "mode": {
          "enum": [
            "MANUAL",
            "AUTOMATED",
            "HYBRID"
          ]
        },
        "trigger_event_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "manualOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "permissions",
        "can_bypass",
        "requires_reason"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "can_bypass": {
          "type": "array",
          "items": {
            "enum": [
              "GUARDS",
              "EVIDENCE"
            ]
          },
          "uniqueItems": true
        },
        "requires_reason": {
          "type": "boolean"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reason_required"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "reason_required": {
          "type": "boolean"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "purpose",
        "axis_id",
        "from",
        "to",
        "command_id",
        "event_type",
        "guards",
        "required_evidence",
        "permissions",
        "approval",
        "effects",
        "failure",
        "retry",
        "automation",
        "manual_override",
        "audit",
        "reversible"
      ],
      "properties": {
        "transition_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "purpose": {
          "enum": [
            "NORMAL",
            "APPROVAL",
            "REJECT",
            "HOLD",
            "CANCEL",
            "FAIL",
            "RETRY",
            "RESUME",
            "ROLLBACK",
            "COMPENSATION",
            "RESTORE",
            "CORRECTION",
            "TIMEOUT",
            "ESCALATION",
            "REOBSERVE",
            "INVALIDATE"
          ]
        },
        "axis_id": {
          "type": "string"
        },
        "from": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "to": {
          "type": "string"
        },
        "command_id": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "guards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effect_id",
              "kind"
            ],
            "properties": {
              "effect_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "INTERNAL",
                  "EXTERNAL",
                  "OUTBOX",
                  "NOTIFY",
                  "PROJECT"
                ]
              },
              "compensatable": {
                "type": "boolean"
              }
            }
          }
        },
        "failure": {
          "$ref": "#/$defs/failure"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "timeout": {
          "$ref": "#/$defs/timeout"
        },
        "sla": {
          "$ref": "#/$defs/sla"
        },
        "automation": {
          "$ref": "#/$defs/automation"
        },
        "manual_override": {
          "$ref": "#/$defs/manualOverride"
        },
        "audit": {
          "$ref": "#/$defs/audit"
        },
        "reversible": {
          "type": "boolean"
        },
        "compensation_transition_id": {
          "type": "string"
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "status",
        "opening_event_type",
        "closing_event_types",
        "due_within_ms"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "status": {
          "enum": [
            "PILOT",
            "CANONICAL"
          ]
        },
        "opening_event_type": {
          "type": "string"
        },
        "closing_event_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "due_within_ms": {
          "type": "integer",
          "minimum": 1
        },
        "escalation_event_type": {
          "type": "string"
        }
      }
    }
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AI Core Project Capsule Inspection",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","project_id","repository","default_branch","subject_revision","observed_at","classification","commands","delivery","instructions","data_evidence","readiness","evidence_refs"],
  "properties":{
    "schema":{"const":"ai-core-project-capsule/v1"},
    "project_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,62}$"},
    "repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "default_branch":{"type":"string","minLength":1},
    "subject_revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "observed_at":{"type":"string","format":"date-time"},
    "classification":{
      "type":"object","additionalProperties":false,
      "required":["kind","framework","package_manager"],
      "properties":{
        "kind":{"enum":["NODE_APP","STATIC_WEB","DOCUMENT_REPO","TOOLKIT","UNKNOWN"]},
        "framework":{"type":["string","null"]},
        "package_manager":{"type":["string","null"]}
      }
    },
    "commands":{
      "type":"object","additionalProperties":false,
      "required":["install","test","build","start","absent_reason"],
      "properties":{
        "install":{"type":["string","null"]},
        "test":{"type":["string","null"]},
        "build":{"type":["string","null"]},
        "start":{"type":["string","null"]},
        "absent_reason":{
          "type":"object",
          "additionalProperties":{"type":"string","minLength":1}
        }
      }
    },
    "delivery":{
      "type":"object","additionalProperties":false,
      "required":["targets","workflows"],
      "properties":{
        "targets":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "workflows":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "instructions":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "data_evidence":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "readiness":{
      "type":"object","additionalProperties":false,
      "required":["status","blockers","review_required"],
      "properties":{
        "status":{"enum":["READY_FOR_REGISTRY_REVIEW","HOLD"]},
        "blockers":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "review_required":{"const":true}
      }
    },
    "evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
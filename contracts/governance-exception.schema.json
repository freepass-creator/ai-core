{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.freepass.ai/governance/exception/v1",
  "title":"AI Core Governance Exception v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","exception_id","standard_rule","project_id","scope","reason","risk",
    "approved_by","created_at","expires_at","replacement_plan","status"
  ],
  "properties":{
    "schema_version":{"const":"governance-exception/v1"},
    "exception_id":{"type":"string","minLength":1},
    "standard_rule":{"type":"string","minLength":1},
    "project_id":{"type":"string","minLength":1},
    "scope":{"type":"string","minLength":1},
    "reason":{"type":"string","minLength":1},
    "risk":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},
    "approved_by":{"type":"string","minLength":1},
    "created_at":{"type":"string","format":"date-time"},
    "expires_at":{"type":["string","null"],"format":"date-time"},
    "replacement_plan":{"type":"string","minLength":1},
    "status":{"enum":["ACTIVE","EXPIRED","CLOSED","PERMANENT_PROFILE_CANDIDATE"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/execution-lease/v1",
  "title": "AI Core Logical Execution Lease v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "logical_execution_id",
    "identity_digest",
    "attempt_id",
    "owner_id",
    "fencing_token",
    "state",
    "claimed_at",
    "lease_until",
    "heartbeat_at",
    "released_at"
  ],
  "properties": {
    "schema_version": {
      "const": "core-execution-lease/v1"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^lease\\.[a-zA-Z0-9._-]+$"
    },
    "logical_execution_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
    },
    "identity_digest": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/checksum"
    },
    "attempt_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "ACTIVE",
        "RELEASED",
        "EXPIRED",
        "SUPERSEDED"
      ]
    },
    "claimed_at": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
    },
    "lease_until": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
    },
    "heartbeat_at": {
      "anyOf": [
        {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
        },
        {
          "type": "null"
        }
      ]
    },
    "released_at": {
      "anyOf": [
        {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/workflow-progression.schema.json",
  "title": "AI Core Workflow Progression Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "progressions"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "progressions": { "type": "array", "items": { "$ref": "#/$defs/progression" } }
  },
  "$defs": {
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "files"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "blob_sha"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          }
        }
      }
    },
    "adoptionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "repository", "revision", "verification"],
      "properties": {
        "stage": { "enum": ["SOURCE_MODELED", "SOURCE_PARITY_VERIFIED", "RUNTIME_PILOT", "RUNTIME_CANONICAL"] },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "conclusion", "files"],
          "properties": {
            "kind": { "enum": ["CI", "RUNTIME"] },
            "conclusion": { "enum": ["SUCCESS", "FAILURE", "HOLD"] },
            "run_id": { "type": ["integer", "string"] },
            "observed_at": { "type": "string" },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "blob_sha"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
                }
              }
            }
          }
        }
      }
    },
    "inferenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id", "when_target_at_or_after", "inferred_fact_id",
        "provenance_required", "forbidden_completion_fact_ids"
      ],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "when_target_at_or_after": { "type": "string", "minLength": 1 },
        "inferred_fact_id": { "type": "string", "minLength": 1 },
        "provenance_required": { "const": true },
        "forbidden_completion_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string" }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "progression_id", "version", "adoption_status", "owner",
        "workflow_id", "axis_id", "ordered_states", "mode",
        "allow_forward_skip", "backward_policy", "same_state_policy",
        "skipped_state_evidence_policy", "inference_rules", "source_authority"
      ],
      "properties": {
        "progression_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "adoption_status": { "enum": ["SHADOW", "PILOT", "CANONICAL", "DEPRECATED"] },
        "owner": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "workflow_id": { "type": "string", "minLength": 1 },
        "axis_id": { "type": "string", "minLength": 1 },
        "ordered_states": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "mode": { "const": "MONOTONIC_FORWARD" },
        "allow_forward_skip": { "type": "boolean" },
        "backward_policy": { "const": "FORBID" },
        "same_state_policy": { "enum": ["NOOP", "ALLOW_REASSERT"] },
        "skipped_state_evidence_policy": { "const": "NO_FABRICATED_COMPLETION" },
        "inference_rules": { "type": "array", "items": { "$ref": "#/$defs/inferenceRule" } },
        "source_authority": { "$ref": "#/$defs/sourceAuthority" },
        "adoption_evidence": { "$ref": "#/$defs/adoptionEvidence" }
      }
    }
  }
}

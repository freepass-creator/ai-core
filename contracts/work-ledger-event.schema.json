{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Core Work Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "work_id", "project_id", "type", "from_state", "to_state", "actor", "subject_revision", "observed_at", "evidence_refs"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$" },
    "work_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$" },
    "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "type": { "enum": ["CREATED", "TRANSITIONED", "BLOCKED", "RESUMED", "CANCELLED"] },
    "from_state": { "type": ["string", "null"], "enum": [null, "RECEIVED", "PLANNED", "IN_PROGRESS", "VERIFYING", "AWAITING_AUTHORIZATION", "READY", "EXECUTED", "OBSERVING", "CLOSED", "BLOCKED", "CANCELLED"] },
    "to_state": { "enum": ["RECEIVED", "PLANNED", "IN_PROGRESS", "VERIFYING", "AWAITING_AUTHORIZATION", "READY", "EXECUTED", "OBSERVING", "CLOSED", "BLOCKED", "CANCELLED"] },
    "actor": { "type": "string", "minLength": 1 },
    "subject_revision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/code-set/v1",
  "title": "AI Core Enum and Code Set Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "set_id",
    "version",
    "owner",
    "open_enum",
    "values"
  ],
  "properties": {
    "schema_version": {
      "const": "core-code-set/v1"
    },
    "set_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "open_enum": {
      "type": "boolean",
      "description": "true means consumers must safely tolerate unknown future codes"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "status": {
            "enum": [
              "ACTIVE",
              "DEPRECATED",
              "RETIRED"
            ]
          },
          "deprecated_since": {
            "type": [
              "string",
              "null"
            ]
          },
          "replacement_code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    }
  }
}

{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.freepass.ai/governance/rollback-plan/v1",
  "title":"AI Core Rollback Plan v1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","project_id","environment","from_revision","previous_known_good_revision",
    "rollback_method","data_strategy","trigger_conditions","verification","irreversible_effects"
  ],
  "properties":{
    "schema_version":{"const":"governance-rollback-plan/v1"},
    "project_id":{"type":"string","minLength":1},
    "environment":{"type":"string","minLength":1},
    "from_revision":{"type":"string","minLength":1},
    "previous_known_good_revision":{"type":"string","minLength":1},
    "rollback_method":{"type":"string","minLength":1},
    "data_strategy":{"enum":["REVERSIBLE","RESTORE_SNAPSHOT","FORWARD_FIX","NOT_APPLICABLE","UNKNOWN"]},
    "trigger_conditions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "verification":{
      "type":"object",
      "additionalProperties":false,
      "required":["command_or_procedure","expected_evidence"],
      "properties":{
        "command_or_procedure":{"type":"string","minLength":1},
        "expected_evidence":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "irreversible_effects":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/query/v1",
  "title": "AI Core Search Filter Sort Query v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "search",
    "filters",
    "sort",
    "page"
  ],
  "properties": {
    "schema_version": {
      "const": "core-query/v1"
    },
    "search": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "operator",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "operator": {
            "enum": [
              "EQ",
              "NE",
              "GT",
              "GTE",
              "LT",
              "LTE",
              "IN",
              "NOT_IN",
              "CONTAINS",
              "STARTS_WITH",
              "IS_NULL",
              "IS_NOT_NULL"
            ]
          },
          "value": {}
        }
      }
    },
    "sort": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "direction"
        ],
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "direction": {
            "enum": [
              "ASC",
              "DESC"
            ]
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "limit"
      ],
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    }
  }
}

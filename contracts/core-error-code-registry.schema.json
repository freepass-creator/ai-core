{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/error-code-registry/v1",
  "title": "AI Core Error Code Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "codes"
  ],
  "properties": {
    "schema_version": {
      "const": "core-error-code-registry/v1"
    },
    "owner": {
      "const": "C_CORE_CONTRACT_STANDARD"
    },
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "category",
          "default_http_status",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "category": {
            "enum": [
              "USER",
              "SYSTEM",
              "PROVIDER"
            ]
          },
          "default_http_status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

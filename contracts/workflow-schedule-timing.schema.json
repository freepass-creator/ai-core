{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/workflow-schedule-timing.schema.json",
  "title": "AI Core Workflow Schedule Timing Policy Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "policies"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_id",
          "status",
          "evidence_level",
          "observation_contract",
          "late_after_ms",
          "missed_after_ms",
          "source_evidence"
        ],
        "properties": {
          "policy_id": {
            "type": "string",
            "pattern": "^workflow\\.[a-z0-9][a-z0-9.-]*$"
          },
          "status": {
            "enum": [
              "PROPOSED",
              "PILOT",
              "COMMON_ADOPTED",
              "DEPRECATED"
            ]
          },
          "evidence_level": {
            "enum": [
              "FAILURE_RUNTIME_EVIDENCE",
              "PROJECT_VERIFIED",
              "CROSS_PROJECT_VERIFIED",
              "COMMON_ADOPTED"
            ]
          },
          "observation_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract_id",
              "status"
            ],
            "properties": {
              "contract_id": {
                "const": "core.schedule-observation.v1"
              },
              "status": {
                "enum": [
                  "PENDING",
                  "AVAILABLE"
                ]
              }
            }
          },
          "late_after_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "missed_after_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "source_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "revision",
                "path",
                "blob_sha"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "blob_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

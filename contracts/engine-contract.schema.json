{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engine Contract",
  "type": "object",
  "required": ["engine_id", "version", "source", "inputs", "outputs", "invariants", "required_ports", "side_effects", "verification_profile"],
  "properties": {
    "engine_id": {"type": "string", "minLength": 3},
    "version": {"type": "string", "minLength": 1},
    "scope": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["locator", "revision"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_ports": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "side_effects": {"type": "boolean"},
    "error_model": {"type": "array", "items": {"type": "string"}},
    "applicability": {"type": "array", "items": {"type": "string"}},
    "non_applicability": {"type": "array", "items": {"type": "string"}},
    "verification_profile": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
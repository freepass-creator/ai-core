{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/snapshot/v1",
  "title": "AI Core Immutable Snapshot Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "subject_type",
    "subject_id",
    "subject_revision",
    "source_revision",
    "created_at",
    "payload",
    "payload_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "core-snapshot/v1"
    },
    "snapshot_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
    },
    "subject_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "subject_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
    },
    "subject_revision": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
    },
    "source_revision": {
      "anyOf": [
        {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
    },
    "payload": {},
    "payload_digest": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/checksum"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/contract-registry/v1",
  "title": "AI Core Contract Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "revision",
    "conventions",
    "contracts"
  ],
  "properties": {
    "schema_version": {
      "const": "core-contract-registry/v1"
    },
    "owner": {
      "const": "C_CORE_CONTRACT_STANDARD"
    },
    "revision": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "conventions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "path",
          "status",
          "compatibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*\\.v[1-9][0-9]*$"
          },
          "domain": {
            "enum": [
              "DATA",
              "ENGINE_ADAPTER",
              "IMPORT_EXPORT",
              "API",
              "EVENT",
              "ERROR",
              "RESULT",
              "RECEIPT",
              "CODE"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^contracts/[A-Za-z0-9._/-]+\\.json$"
          },
          "status": {
            "enum": [
              "CANONICAL",
              "DEPRECATED",
              "EXPERIMENTAL"
            ]
          },
          "compatibility": {
            "enum": [
              "ADDITIVE_ONLY_WITHIN_V1",
              "BREAKING_REQUIRES_NEW_MAJOR"
            ]
          }
        }
      }
    }
  }
}

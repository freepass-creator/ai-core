{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/binding-profile/v1",
  "title": "AI Core Engine Adapter Binding Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "project_id",
    "environment",
    "subject_revision",
    "engine_bindings",
    "config_refs",
    "secret_refs",
    "verification_state"
  ],
  "properties": {
    "schema_version": {
      "const": "core-binding-profile/v1"
    },
    "profile_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "subject_revision": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
    },
    "engine_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine_id",
          "engine_version",
          "ports"
        ],
        "properties": {
          "engine_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "engine_version": {
            "type": "string",
            "minLength": 1
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port_id",
                "adapter_id"
              ],
              "properties": {
                "port_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
                },
                "adapter_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
                }
              }
            }
          }
        }
      }
    },
    "config_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "secret_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_state": {
      "enum": [
        "NOT_RUN",
        "PARTIAL",
        "PASSED_WITHIN_SCOPE",
        "FAILED",
        "STALE"
      ]
    },
    "service_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service_id",
          "service_version",
          "ports"
        ],
        "properties": {
          "service_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "service_version": {
            "type": "string",
            "minLength": 1
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port_id",
                "adapter_id"
              ],
              "properties": {
                "port_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
                },
                "adapter_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
                }
              }
            }
          }
        }
      }
    }
  }
}

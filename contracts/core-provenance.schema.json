{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/provenance/v1",
  "title": "AI Core Source Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_owner",
    "canonical_writer",
    "subject",
    "source",
    "normalization"
  ],
  "properties": {
    "schema_version": {
      "const": "core-provenance/v1"
    },
    "canonical_owner": {
      "type": "string",
      "minLength": 1
    },
    "canonical_writer": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type",
        "id"
      ],
      "properties": {
        "entity_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "id": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "source_ref",
        "observed_at"
      ],
      "properties": {
        "source_id": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
        },
        "source_type": {
          "enum": [
            "DATABASE",
            "API",
            "FILE",
            "SHEET",
            "MESSAGE",
            "MANUAL",
            "DERIVED",
            "OTHER"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
        },
        "source_checksum": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/checksum"
        },
        "observed_at": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
        }
      },
      "anyOf": [
        {
          "required": [
            "source_revision"
          ]
        },
        {
          "required": [
            "source_checksum"
          ]
        }
      ]
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalizer_id",
        "normalizer_version"
      ],
      "properties": {
        "normalizer_id": {
          "type": "string",
          "minLength": 1
        },
        "normalizer_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "field_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_field",
          "source_path"
        ],
        "properties": {
          "canonical_field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_value_digest": {
            "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/checksum"
          },
          "transformation": {
            "type": "string",
            "minLength": 1
          },
          "verification_state": {
            "enum": [
              "UNVERIFIED",
              "VERIFIED",
              "REVIEW_REQUIRED",
              "REJECTED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}

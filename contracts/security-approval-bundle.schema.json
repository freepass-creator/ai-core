{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/security/approval-bundle/v1",
  "title": "AI Core Exact-Subject Approval Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "policy_id",
    "risk_class",
    "subject",
    "requester_id",
    "executor_id",
    "reviews",
    "owner_approval",
    "emergency_approval"
  ],
  "properties": {
    "schema_version": {"const": "security-approval-bundle/v1"},
    "approval_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "risk_class": {
      "enum": [
        "READ_ONLY",
        "LOCAL_MUTATION",
        "REVERSIBLE_EXTERNAL_MUTATION",
        "PRIVILEGED_MUTATION",
        "IRREVERSIBLE_EXTERNAL_ACTION"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_revision",
        "plan_digest",
        "target_digest",
        "artifact_digest",
        "command_digest",
        "target_count"
      ],
      "properties": {
        "subject_revision": {"type": "string", "minLength": 1},
        "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "command_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_count": {"type": "integer", "minimum": 0}
      }
    },
    "requester_id": {"type": "string", "minLength": 1},
    "executor_id": {"type": "string", "minLength": 1},
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "decision", "reason", "reviewed_at", "expires_at"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["APPROVE", "BLOCK"]},
          "reason": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "owner_approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["approver_id", "approved_at", "expires_at"],
      "properties": {
        "approver_id": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "emergency_approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["approver_id", "reason", "approved_at", "expires_at"],
      "properties": {
        "approver_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/execution-identity/v1",
  "title": "AI Core Logical Execution Identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logical_execution_id",
    "identity_digest",
    "dimensions",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "core-execution-identity/v1"
    },
    "logical_execution_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
    },
    "identity_digest": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/checksum"
    },
    "dimensions": {
      "$ref": "#/$defs/dimensions"
    },
    "created_at": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
    }
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_kind",
        "logical_slot",
        "subject_scope",
        "semantic_input_digest"
      ],
      "properties": {
        "operation_kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "logical_slot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_type",
            "scope_key"
          ],
          "properties": {
            "scope_type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]*$"
            },
            "scope_key": {
              "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
            }
          }
        },
        "semantic_input_digest": {
          "anyOf": [
            {
              "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/checksum"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_execution_id",
        "identity_digest",
        "attempt_id",
        "attempt_sequence",
        "execution_path"
      ],
      "properties": {
        "logical_execution_id": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
        },
        "identity_digest": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/checksum"
        },
        "attempt_id": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
        },
        "attempt_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "execution_path": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "parent_attempt_id": {
          "anyOf": [
            {
              "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}

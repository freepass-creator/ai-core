{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/ui-ux-machine-conformance.schema.json",
  "title": "AI Core UI/UX Machine Conformance Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "style_files",
    "usage_files",
    "rules"
  ],
  "properties": {
    "contract": {
      "const": "ai-core-ui-machine-conformance/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "style_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "usage_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target_classes",
          "property"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "target_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            }
          },
          "property": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "allowed_values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowed_patterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "require_match": {
            "type": "boolean",
            "default": false
          }
        },
        "anyOf": [
          {
            "required": [
              "allowed_values"
            ]
          },
          {
            "required": [
              "allowed_patterns"
            ]
          }
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/adapter-result/v1",
  "title": "AI Core Adapter Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "correlation_id",
    "status",
    "retryable",
    "issues",
    "evidence_refs",
    "started_at",
    "ended_at"
  ],
  "properties": {
    "schema_version": {
      "const": "core-adapter-result/v1"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_revision": {
      "anyOf": [
        {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/correlation_id"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "HOLD",
        "FAILED"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "data": {},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "severity": {
            "enum": [
              "INFO",
              "WARNING",
              "ERROR",
              "BLOCKING"
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "started_at": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
    },
    "ended_at": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
    },
    "execution": {
      "$ref": "https://schemas.freepass.ai/core/execution-identity/v1#/$defs/binding"
    }
  }
}

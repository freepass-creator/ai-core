{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/application-service/v1",
  "title": "AI Core Application Service Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service_id",
    "version",
    "source",
    "use_cases",
    "required_ports",
    "side_effects",
    "idempotency",
    "actor_requirement",
    "transaction_boundary",
    "error_codes",
    "verification_profile"
  ],
  "properties": {
    "schema_version": {
      "const": "core-application-service-contract/v1"
    },
    "service_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "revision"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
        }
      }
    },
    "use_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "input_contract",
          "output_contract"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]*$"
          },
          "input_contract": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_contract": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "required_ports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "port_id",
          "port_version"
        ],
        "properties": {
          "port_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "port_version": {
            "type": "string",
            "pattern": "^v[1-9][0-9]*$"
          }
        }
      }
    },
    "side_effects": {
      "type": "boolean"
    },
    "idempotency": {
      "enum": [
        "REQUIRED",
        "SUPPORTED",
        "NOT_APPLICABLE"
      ]
    },
    "actor_requirement": {
      "enum": [
        "REQUIRED",
        "OPTIONAL",
        "NONE"
      ]
    },
    "transaction_boundary": {
      "enum": [
        "REPOSITORY_ATOMIC",
        "ORCHESTRATED",
        "READ_ONLY",
        "NONE"
      ]
    },
    "error_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "verification_profile": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "side_effects": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "required_ports": {
            "minItems": 1
          }
        }
      }
    }
  ]
}

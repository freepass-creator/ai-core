{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/receipt/v1",
  "title": "AI Core Execution Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "operation_id",
    "operation_kind",
    "actor",
    "executor",
    "correlation_id",
    "status",
    "reason_code",
    "input",
    "output",
    "source_revision",
    "started_at",
    "ended_at",
    "evidence_refs",
    "reproducibility"
  ],
  "properties": {
    "schema_version": {
      "const": "core-receipt/v1"
    },
    "receipt_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
    },
    "operation_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
    },
    "operation_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/correlation_id"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "HOLD",
        "FAILED",
        "PARTIAL"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "refs"
      ],
      "properties": {
        "digest": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/checksum"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "refs"
      ],
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/checksum"
            },
            {
              "type": "null"
            }
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_revision": {
      "anyOf": [
        {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
    },
    "ended_at": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "executor_version",
        "environment_revision",
        "command_ref"
      ],
      "properties": {
        "deterministic": {
          "type": "boolean"
        },
        "executor_version": {
          "type": "string",
          "minLength": 1
        },
        "environment_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "command_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "observed_at",
          "evidence_refs"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "observed_at": {
            "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "description": "Observed execution/delivery milestones. Milestone names do not define business workflow state."
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      },
      "description": "Optional operation metrics. Project-specific raw payloads must not be copied here; only compact non-sensitive measurements."
    },
    "execution": {
      "$ref": "https://schemas.freepass.ai/core/execution-identity/v1#/$defs/binding"
    },
    "proof_input_binding": {
      "$ref": "https://schemas.freepass.ai/core/proof-input-binding/v1",
      "description": "Optional proof freshness binding. If any bound source/checker/fixture/config/schema/dependency input changes, the prior proof is stale until rerun."
    },
    "child_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receipt_ref",
          "relation"
        ],
        "properties": {
          "receipt_ref": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "PORT",
              "ADAPTER",
              "REPOSITORY",
              "EFFECT",
              "COMPENSATION",
              "OTHER"
            ]
          }
        }
      },
      "description": "Optional child execution receipts that contributed to this result. References do not imply workflow completion."
    }
  }
}

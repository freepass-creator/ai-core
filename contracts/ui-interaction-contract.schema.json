{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.local/contracts/ui-interaction-contract.schema.json",
  "title": "AI Core UI Interaction Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "feature_registry",
    "constitution",
    "rules"
  ],
  "properties": {
    "contract": {
      "const": "ai-core-ui-interaction-contract/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "feature_registry": {
      "const": "registry/ui-ux-features.json"
    },
    "constitution": {
      "const": "docs/UI_UX_CONSTITUTION.md"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_placement",
        "focus",
        "search_context",
        "single_choice_flow",
        "async_write",
        "external_action",
        "responsive",
        "accessibility",
        "internationalization",
        "file_image_ui",
        "status_feedback",
        "input_method",
        "portable_task_panel",
        "selection_state"
      ],
      "properties": {
        "action_placement": {
          "$ref": "#/$defs/rule"
        },
        "focus": {
          "$ref": "#/$defs/rule"
        },
        "search_context": {
          "$ref": "#/$defs/rule"
        },
        "single_choice_flow": {
          "$ref": "#/$defs/rule"
        },
        "async_write": {
          "$ref": "#/$defs/rule"
        },
        "external_action": {
          "$ref": "#/$defs/rule"
        },
        "responsive": {
          "$ref": "#/$defs/rule"
        },
        "accessibility": {
          "$ref": "#/$defs/rule"
        },
        "internationalization": {
          "$ref": "#/$defs/rule"
        },
        "file_image_ui": {
          "$ref": "#/$defs/rule"
        },
        "status_feedback": {
          "$ref": "#/$defs/rule"
        },
        "input_method": {
          "$ref": "#/$defs/rule"
        },
        "portable_task_panel": {
          "$ref": "#/$defs/rule"
        },
        "selection_state": {
          "$ref": "#/$defs/rule"
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_refs",
        "invariants",
        "verification"
      ],
      "properties": {
        "feature_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.freepass.ai/core/event/v1",
  "title": "AI Core Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "event_version",
    "producer",
    "occurred_at",
    "recorded_at",
    "correlation_id",
    "causation_id",
    "subject",
    "payload",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "core-event/v1"
    },
    "event_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*){2,}$"
    },
    "event_version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
    },
    "recorded_at": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/datetime"
    },
    "correlation_id": {
      "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/correlation_id"
    },
    "causation_id": {
      "anyOf": [
        {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "revision"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "id": {
          "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/stable_id"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "https://schemas.freepass.ai/core/types/v1#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "payload": {},
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution": {
      "$ref": "https://schemas.freepass.ai/core/execution-identity/v1#/$defs/binding"
    }
  }
}
